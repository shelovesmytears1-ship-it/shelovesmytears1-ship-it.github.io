---
import { getCollection } from 'astro:content';
import { withBase } from '../i18n/ui';
import { getSummary } from '../data/caseHelpers';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const heroCases = cases.filter((entry) => ['wavemetrics', 'dispersia', 'interspace'].includes(entry.slug));
const featuredCases = cases.slice(0, 6);
const stageCases = heroCases.length === 3 ? heroCases : cases.slice(0, 3);
const coverSrcset = (cover: string) =>
  `${withBase(cover.replace(/^\/covers\/(.+)\.jpe?g$/i, '/covers/4k/$1.webp'))} 3840w, ${withBase(cover.replace(/\.jpe?g$/i, '.webp'))} 1280w`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090b" />
    <meta name="robots" content="noindex, nofollow" />
    <title>overflow — Director's cut</title>
    <meta name="description" content="Cinematic redesign direction for overflow portfolio." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" />
  </head>
  <body>
    <a class="skip" href="#content">К содержанию</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true"></div>

    <header class="dc-nav">
      <a class="dc-brand" href="#top" aria-label="overflow — начало страницы">overflow<span>.</span></a>
      <nav aria-label="Основная навигация">
        <a href="/director-cut/work/">Работы</a>
        <a href="/director-cut/method/">Подход</a>
        <a href="/director-cut/about/">Обо мне</a>
      </nav>
      <a class="dc-talk" href="/director-cut/contact/">Начать проект <span aria-hidden="true">↗</span></a>
    </header>

    <main id="content">
      <section class="dc-hero" id="top" data-hero>
        <div class="hero__atmosphere" aria-hidden="true"></div>
        <canvas class="hero__webgl" data-webgl-shader aria-hidden="true"></canvas>
        <div class="hero__grid">
          <p class="hero__eyebrow" data-hero-copy>Independent digital craft<br />Warsaw · Europe · Remote</p>
          <div class="hero__copy">
            <h1 aria-label="Сайты, которые оставляют след">
              <span class="hero__line"><span data-hero-line>Сайты,</span></span>
              <span class="hero__line"><span data-hero-line>которые</span></span>
              <span class="hero__line hero__line--accent"><span data-hero-line>оставляют след.</span></span>
            </h1>
            <p class="hero__lede" data-hero-copy>Проектирую и собираю многостраничные сайты, лендинги и digital-продукты — от первой идеи до запуска.</p>
          </div>
          <a class="hero__scroll" href="#work" data-hero-copy><span>Листать работы</span><i aria-hidden="true"></i></a>
        </div>

        <div class="hero-stage" aria-label="Selected projects" data-stage>
          <div class="stage__halo" aria-hidden="true"></div>
          <div class="stage__world" data-stage-world>
            {stageCases.map((project, index) => (
              <a
                href={`/director-cut/work/${project.slug}/`}
                class:list={['stage-card', `stage-card--${index + 1}`]}
                data-stage-card
                aria-label={`Открыть кейс ${project.data.title}`}
              >
                {project.data.cover && (
                  <picture>
                    <source type="image/webp" srcset={coverSrcset(project.data.cover)} sizes="(min-width: 900px) 36vw, 72vw" />
                    <img src={withBase(project.data.cover)} alt="" width="3840" height="2400" loading={index === 0 ? 'eager' : 'lazy'} />
                  </picture>
                )}
                <span class="stage-card__label"><b>{String(index + 1).padStart(2, '0')}</b>{project.data.title}</span>
              </a>
            ))}
          </div>
          <span class="stage__note" aria-hidden="true">move to explore</span>
        </div>
      </section>

      <section class="statement dc-shell" data-reveal>
        <p class="dc-kicker">01 — Digital presence</p>
        <h2>Не просто показать бизнес.<br /><em>Дать ему характер.</em></h2>
        <div class="statement__bottom">
          <p>Визуальная система, сценарий, интерфейс и код работают как одно целое. Так сайт запоминают — и на него возвращаются.</p>
          <a href="/director-cut/method/" class="text-link">Как строится работа <span aria-hidden="true">↘</span></a>
        </div>
      </section>

      <section class="dc-work" id="work">
        <div class="dc-shell work__head" data-reveal>
          <p class="dc-kicker">02 — Selected work</p>
          <h2>Каждый проект —<br /><em>свой мир.</em></h2>
          <a href="/director-cut/work/" class="text-link">Все кейсы <span aria-hidden="true">↗</span></a>
        </div>
        <div class="work-rail" data-rail>
          {featuredCases.map((project, index) => (
            <article class="work-card" data-rail-card>
              <a href={`/director-cut/work/${project.slug}/`} class="work-card__visual" aria-label={`Открыть кейс ${project.data.title}`} style={`--project-bg: ${project.data.bg || '#171a20'};`}>
                {project.data.cover && (
                  <picture>
                    <source type="image/webp" srcset={coverSrcset(project.data.cover)} sizes="(min-width: 900px) 64vw, 88vw" />
                    <img src={withBase(project.data.cover)} alt="" width="3840" height="2400" loading="lazy" />
                  </picture>
                )}
                <span class="work-card__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="work-card__open" aria-hidden="true">↗</span>
              </a>
              <div class="work-card__copy">
                <p>{project.data.niche} · {project.data.year}</p>
                <h3>{project.data.title}</h3>
                <span>{getSummary(project, 'ru')}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="method dc-shell" id="method">
        <div class="method__head" data-reveal>
          <p class="dc-kicker">03 — The approach</p>
          <h2>Большая идея.<br /><em>Точная сборка.</em></h2>
          <p>Без презентаций ради презентаций. Решения проверяются в браузере — там, где сайт действительно живёт.</p>
        </div>
        <ol class="method__steps" data-reveal>
          <li><span>01</span><h3>Рамка</h3><p>Цели, аудитория и то, что должно измениться после запуска.</p></li>
          <li><span>02</span><h3>Направление</h3><p>Один визуальный язык и сценарий, в который можно поверить.</p></li>
          <li><span>03</span><h3>Система</h3><p>Экран за экраном: типографика, движение, детали и адаптив.</p></li>
          <li><span>04</span><h3>Релиз</h3><p>Быстрый, понятный сайт с SEO-базой и чистым кодом.</p></li>
        </ol>
      </section>

      <section class="about dc-shell" id="about">
        <p class="dc-kicker" data-reveal>04 — The person behind</p>
        <div class="about__copy" data-reveal>
          <h2>Код — не финальный этап.<br /><em>Это часть дизайна.</em></h2>
          <p>Я совмещаю стратегию, дизайн и frontend-разработку в одном процессе. Поэтому идея не теряется между макетом и реальным сайтом.</p>
          <a href="/director-cut/about/" class="text-link">Узнать больше <span aria-hidden="true">↗</span></a>
        </div>
        <div class="about__orb" aria-hidden="true"><span></span><span></span><span></span></div>
      </section>

      <section class="contact" id="contact">
        <div class="contact__light" aria-hidden="true"></div>
        <div class="dc-shell contact__inner" data-reveal>
          <p class="dc-kicker">05 — Start something true</p>
          <h2>Есть задача<br />с амбициями?</h2>
          <p>Расскажите, что должно измениться. Отвечу с вопросами, планом и честной оценкой.</p>
        <div class="contact__actions">
            <a class="contact__button" href="https://t.me/zzxvaracaa" target="_blank" rel="noopener">Написать в Telegram <span aria-hidden="true">↗</span></a>
            <a class="contact__email" href="mailto:overflow.web1@gmail.com">overflow.web1@gmail.com</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="dc-footer dc-shell"><a class="dc-brand" href="#top">overflow<span>.</span></a><span>Director's cut · 2026</span><a href="/director-cut/contact/">Contact ↗</a></footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      const world = document.querySelector<HTMLElement>('[data-stage-world]');
      const glow = document.querySelector<HTMLElement>('.cursor-glow');
      const shaderCanvas = document.querySelector<HTMLCanvasElement>('[data-webgl-shader]');

      // Adapted from the real 21st.dev "WebGL Shader" component by designali-in.
      // Its GLSL animation is retained; only the React/Three wrapper is replaced for Astro.
      if (shaderCanvas) {
        const gl = shaderCanvas.getContext('webgl', { alpha: true, antialias: false });
        if (gl) {
          const vertexSource = `
            attribute vec3 position;
            void main() { gl_Position = vec4(position, 1.0); }
          `;
          const fragmentSource = `
            precision highp float;
            uniform vec2 resolution;
            uniform float time;
            uniform float xScale;
            uniform float yScale;
            uniform float distortion;
            void main() {
              vec2 p = (gl_FragCoord.xy * 2.0 - resolution) / min(resolution.x, resolution.y);
              float d = length(p) * distortion;
              float rx = p.x * (1.0 + d);
              float gx = p.x;
              float bx = p.x * (1.0 - d);
              float r = 0.05 / abs(p.y + sin((rx + time) * xScale) * yScale);
              float g = 0.05 / abs(p.y + sin((gx + time) * xScale) * yScale);
              float b = 0.05 / abs(p.y + sin((bx + time) * xScale) * yScale);
              gl_FragColor = vec4(r, g, b, 1.0);
            }
          `;
          const compile = (type: number, source: string) => {
            const shader = gl.createShader(type)!;
            gl.shaderSource(shader, source);
            gl.compileShader(shader);
            return shader;
          };
          const program = gl.createProgram()!;
          gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexSource));
          gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentSource));
          gl.linkProgram(program);

          if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
            const buffer = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([
              -1, -1, 0, 1, -1, 0, -1, 1, 0,
              1, -1, 0, -1, 1, 0, 1, 1, 0,
            ]), gl.STATIC_DRAW);
            gl.useProgram(program);
            const position = gl.getAttribLocation(program, 'position');
            gl.enableVertexAttribArray(position);
            gl.vertexAttribPointer(position, 3, gl.FLOAT, false, 0, 0);
            const resolution = gl.getUniformLocation(program, 'resolution');
            const time = gl.getUniformLocation(program, 'time');
            const xScale = gl.getUniformLocation(program, 'xScale');
            const yScale = gl.getUniformLocation(program, 'yScale');
            const distortion = gl.getUniformLocation(program, 'distortion');
            let animation = 0;
            let phase = 0;

            const resize = () => {
              const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
              const { width, height } = shaderCanvas.getBoundingClientRect();
              shaderCanvas.width = Math.max(1, Math.floor(width * ratio));
              shaderCanvas.height = Math.max(1, Math.floor(height * ratio));
              gl.viewport(0, 0, shaderCanvas.width, shaderCanvas.height);
            };
            const render = () => {
              gl.uniform2f(resolution, shaderCanvas.width, shaderCanvas.height);
              gl.uniform1f(time, phase);
              gl.uniform1f(xScale, 1.18);
              gl.uniform1f(yScale, 0.34);
              gl.uniform1f(distortion, 0.065);
              gl.drawArrays(gl.TRIANGLES, 0, 6);
              phase += reduced ? 0 : 0.006;
              if (!reduced) animation = requestAnimationFrame(render);
            };
            resize();
            render();
            window.addEventListener('resize', () => {
              resize();
              if (reduced) render();
            }, { passive: true });
          } else {
            shaderCanvas.remove();
          }
        } else {
          shaderCanvas.remove();
        }
      }

      if (!reduced) {
        document.documentElement.classList.add('dc-motion');
        requestAnimationFrame(() => document.documentElement.classList.add('dc-motion-ready'));

        let frame = 0;
        let pointerX = 0.5;
        let pointerY = 0.5;
        const renderStage = () => {
          if (world) {
            world.style.setProperty('--world-x', `${((pointerX - 0.5) * 14).toFixed(2)}deg`);
            world.style.setProperty('--world-y', `${((0.5 - pointerY) * 9).toFixed(2)}deg`);
          }
          if (glow) {
            glow.style.setProperty('--glow-x', `${(pointerX * 100).toFixed(1)}%`);
            glow.style.setProperty('--glow-y', `${(pointerY * 100).toFixed(1)}%`);
          }
          frame = 0;
        };
        window.addEventListener('pointermove', (event) => {
          pointerX = event.clientX / window.innerWidth;
          pointerY = event.clientY / window.innerHeight;
          if (!frame) frame = requestAnimationFrame(renderStage);
        }, { passive: true });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12 });
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((item) => observer.observe(item));
      }

      const rail = document.querySelector<HTMLElement>('[data-rail]');
      if (rail && !reduced) {
        rail.addEventListener('wheel', (event) => {
          if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
          event.preventDefault();
          rail.scrollBy({ left: event.deltaY, behavior: 'auto' });
        }, { passive: false });
      }
    </script>
  </body>
</html>

<style>
  :root { --ink: #08090b; --paper: #f5f2ea; --mist: #b8b8b3; --line: rgba(245,242,234,.18); --acid: #e8ff56; --rose: #ff6e92; --shell: min(1360px, calc(100vw - 56px)); }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--ink); scroll-behavior: smooth; overflow-x: clip; }
  body { margin: 0; overflow-x: hidden; background: var(--ink); color: var(--paper); font-family: 'Space Grotesk', sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  .dc-shell { width: var(--shell); margin-inline: auto; }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 100; padding: .75rem 1rem; color: var(--ink); background: var(--acid); transform: translateY(-180%); }
  .skip:focus { transform: translateY(0); }
  :focus-visible { outline: 2px solid var(--acid); outline-offset: 5px; }
  .grain { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .018; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.85'/%3E%3C/svg%3E"); }
  .cursor-glow { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(460px circle at var(--glow-x, 50%) var(--glow-y, 20%), rgba(232,255,86,.09), transparent 55%); }
  .dc-nav { position: absolute; inset: 0 0 auto; z-index: 10; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: var(--shell); height: 90px; margin: auto; }
  .dc-brand { font-family: Archivo, sans-serif; font-size: 1.18rem; font-weight: 800; letter-spacing: -.08em; }
  .dc-brand span { color: var(--acid); }
  .dc-nav nav { display: flex; gap: 1.7rem; color: var(--mist); font-size: .72rem; }
  .dc-nav nav a, .dc-talk { transition: color 180ms ease; }
  .dc-nav nav a:hover, .dc-talk:hover { color: var(--acid); }
  .dc-talk { justify-self: end; color: var(--paper); font-size: .75rem; }
  .dc-talk span { color: var(--acid); }
  .dc-hero { position: relative; display: grid; min-height: 100svh; padding: 90px 0 32px; overflow: hidden; isolation: isolate; }
  .hero__atmosphere { position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse 65% 54% at 72% 52%, rgba(69,82,124,.26), transparent 70%), radial-gradient(ellipse 42% 40% at 12% 80%, rgba(255,110,146,.12), transparent 70%); }
  .hero__webgl { position: absolute; inset: 0; z-index: -1; display: block; width: 100%; height: 100%; pointer-events: none; opacity: .46; mix-blend-mode: screen; mask-image: radial-gradient(ellipse 78% 70% at 68% 50%, #000 0%, transparent 75%); }
  .hero__grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(120px, .55fr) minmax(0, 1.45fr) minmax(120px, .45fr); width: var(--shell); margin: auto; align-self: stretch; }
  .hero__grid > *, .statement > *, .work__head > *, .method > *, .about > * { min-width: 0; }
  .hero__eyebrow, .dc-kicker, .work-card__copy p, .stage-card__label, .stage__note { font-family: 'DM Mono', monospace; font-size: .64rem; letter-spacing: .08em; line-height: 1.55; text-transform: uppercase; }
  .hero__eyebrow { align-self: start; margin: 2.5rem 0 0; color: var(--mist); }
  .hero__copy { align-self: end; padding-bottom: 5.5vh; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 12ch; margin-bottom: 2.1rem; font-family: Archivo, sans-serif; font-size: clamp(3.9rem, 8.2vw, 9.5rem); font-weight: 700; letter-spacing: -.095em; line-height: .83; }
  .hero__line { display: block; overflow: hidden; }
  .hero__line > span { display: block; transform-origin: left bottom; }
  .hero__line--accent { color: var(--acid); }
  .hero__lede { max-width: 410px; margin: 0; color: var(--mist); font-size: 1rem; line-height: 1.6; }
  .hero__scroll { align-self: end; justify-self: end; display: flex; align-items: center; gap: .8rem; padding-bottom: 5.5vh; color: var(--mist); font-size: .68rem; }
  .hero__scroll i { display: block; width: 38px; height: 1px; background: currentColor; transform-origin: left; animation: scrollPulse 1.5s ease-in-out infinite; }
  .hero-stage { position: absolute; inset: 14% 5% 4% 44%; z-index: 1; display: grid; place-items: center; perspective: 1300px; pointer-events: none; }
  .stage__halo { position: absolute; width: min(66vw, 800px); aspect-ratio: 1; border: 1px solid rgba(232,255,86,.16); border-radius: 50%; box-shadow: 0 0 130px rgba(232,255,86,.12), inset 0 0 100px rgba(232,255,86,.05); transform: rotateX(72deg) rotateZ(-18deg); }
  .stage__world { --world-x: 0deg; --world-y: 0deg; position: relative; width: min(48vw, 660px); height: min(35vw, 450px); transform-style: preserve-3d; transform: rotateX(calc(8deg + var(--world-y))) rotateY(calc(-12deg + var(--world-x))); transition: transform 440ms cubic-bezier(.2,.75,.2,1); pointer-events: auto; animation: stageFloat 7s cubic-bezier(.45,.05,.55,.95) infinite alternate; }
  .stage-card { position: absolute; overflow: hidden; border: 1px solid rgba(245,242,234,.24); box-shadow: 0 32px 80px rgba(0,0,0,.45); transform-style: preserve-3d; transition: filter 300ms ease, transform 450ms cubic-bezier(.2,.75,.2,1); }
  .stage-card picture, .stage-card img { display: block; width: 100%; height: 100%; }
  .stage-card img { object-fit: cover; }
  .stage-card::after { position: absolute; inset: 0; content: ''; background: linear-gradient(135deg, rgba(255,255,255,.22), transparent 34%, rgba(0,0,0,.34)); pointer-events: none; }
  .stage-card:hover { z-index: 5; filter: brightness(1.16); }
  .stage-card--1 { top: 8%; left: 14%; width: 51%; aspect-ratio: 16 / 10; transform: translateZ(90px) rotateY(-9deg) rotateZ(-4deg); }
  .stage-card--1:hover { transform: translateZ(150px) rotateY(-5deg) rotateZ(-2deg) scale(1.03); }
  .stage-card--2 { top: 42%; right: 4%; width: 43%; aspect-ratio: 16 / 10; transform: translateZ(12px) rotateY(-18deg) rotateZ(5deg); }
  .stage-card--2:hover { transform: translateZ(90px) rotateY(-14deg) rotateZ(3deg) scale(1.03); }
  .stage-card--3 { bottom: 2%; left: 2%; width: 38%; aspect-ratio: 16 / 10; transform: translateZ(-70px) rotateY(16deg) rotateZ(-9deg); }
  .stage-card--3:hover { transform: translateZ(35px) rotateY(12deg) rotateZ(-5deg) scale(1.03); }
  .stage-card__label { position: absolute; right: .8rem; bottom: .65rem; z-index: 2; display: flex; gap: .55rem; align-items: center; color: #fff; text-shadow: 0 1px 12px #000; }
  .stage-card__label b { color: var(--acid); font-weight: 400; }
  .stage__note { position: absolute; right: 0; bottom: 0; color: var(--mist); transform: rotate(90deg) translateX(100%); transform-origin: right bottom; }
  .statement { display: grid; grid-template-columns: minmax(150px, .52fr) minmax(0, 1.48fr); gap: 1.5rem; padding: clamp(9rem, 16vw, 17rem) 0; }
  .dc-kicker { margin: .45rem 0 0; color: var(--acid); }
  h2 { margin-bottom: 0; font-family: Archivo, sans-serif; font-size: clamp(3.2rem, 7vw, 8rem); font-weight: 600; letter-spacing: -.09em; line-height: .86; }
  h2 em { color: var(--rose); font-style: normal; }
  .statement__bottom { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: clamp(4rem, 8vw, 8rem); }
  .statement__bottom p, .method__head > p, .about__copy > p, .contact__inner > p { max-width: 35ch; margin-bottom: 0; color: var(--mist); font-size: .95rem; line-height: 1.65; }
  .text-link { display: inline-flex; gap: .65rem; align-items: center; padding-bottom: .45rem; border-bottom: 1px solid var(--acid); color: var(--paper); font-family: 'DM Mono', monospace; font-size: .67rem; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; transition: color 180ms ease; }
  .text-link:hover { color: var(--acid); }
  .text-link span { color: var(--acid); font-size: 1rem; }
