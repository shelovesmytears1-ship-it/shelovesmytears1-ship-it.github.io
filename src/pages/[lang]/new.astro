---
import type { Lang } from '../../i18n/ui';
import { newDirectionLanguages } from '../../data/newDirectionI18n';
import NewHome from '../new.astro';

export function getStaticPaths() {
  return newDirectionLanguages
    .filter((lang) => lang !== 'pl')
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<NewHome lang={lang} />
