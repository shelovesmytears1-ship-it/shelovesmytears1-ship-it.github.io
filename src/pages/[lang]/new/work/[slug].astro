---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Lang } from '../../../../i18n/ui';
import { newDirectionLanguages } from '../../../../data/newDirectionI18n';
import NewWorkCase from '../../../new/work/[slug].astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return newDirectionLanguages
    .filter((lang) => lang !== 'pl')
    .flatMap((lang) => entries.map((entry) => ({ params: { lang, slug: entry.slug }, props: { lang, entry } })));
}

const { lang, entry } = Astro.props as { lang: Lang; entry: CollectionEntry<'cases'> };
---

<NewWorkCase lang={lang} entry={entry} />
