---
import type { Lang } from '../../../i18n/ui';
import { newDirectionLanguages } from '../../../data/newDirectionI18n';
import NewWork from '../../new/work.astro';

export function getStaticPaths() {
  return newDirectionLanguages
    .filter((lang) => lang !== 'pl')
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<NewWork lang={lang} />
