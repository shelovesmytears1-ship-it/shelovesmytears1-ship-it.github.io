---
import NewDirectionLayout from '../../layouts/NewDirectionLayout.astro';
import { type Lang, withBase } from '../../i18n/ui';
import { getNewDirectionCopy, newDirectionPath } from '../../data/newDirectionI18n';

interface Props { lang?: Lang; }
const { lang = 'pl' } = Astro.props as Props;
const c = getNewDirectionCopy(lang);
const p = (path = '') => withBase(newDirectionPath(lang, path));
const phases = c.method.phases.map((phase, index) => [String(index + 1).padStart(2, '0'), phase.title, phase.text]);
---

<NewDirectionLayout title={c.layout.nav.method} description={c.method.lede} current="method" lang={lang} currentPath="method">
  <section class="new-page-hero new-shell">
    <div class="new-page-hero__grid nd-reveal">
      <span class="new-meta">02 — {c.layout.nav.method}</span>
      <div>
        <h1 class="new-page-title">{c.method.title}<br /><em>{c.method.accent}</em></h1>
        <p class="new-page-lede">{c.method.lede}</p>
      </div>
    </div>
  </section>

  <section class="process-list new-shell" aria-label={c.method.listLabel}>
    {phases.map(([number, title, description]) => (
      <article class="process-row nd-reveal">
        <span class="process-row__number">{number}</span>
        <h2>{title}</h2>
        <p>{description}</p>
      </article>
    ))}
  </section>

  <section class="method-cta">
    <div class="new-shell method-cta__inner nd-reveal">
      <span class="new-meta">{c.method.ctaMeta}</span>
      <h2 class="new-section-title">{c.method.ctaTitle}<br /><em>{c.method.ctaAccent}</em></h2>
      <a class="new-button" href={p('contact')}>{c.method.ctaButton} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</NewDirectionLayout>

<style>
  .process-list { padding-bottom: clamp(8rem, 15vw, 14rem); }
  .process-row { display: grid; grid-template-columns: minmax(80px, .45fr) minmax(220px, .9fr) minmax(0, 1.1fr); gap: 2rem; padding: clamp(2rem, 4vw, 4rem) 0; border-top: 1px solid var(--nd-line); }
  .process-row:last-child { border-bottom: 1px solid var(--nd-line); }
  .process-row__number { color: var(--nd-accent); font-family: var(--nd-mono); font-size: .75rem; }
  .process-row h2 { margin: 0; font-family: var(--nd-serif); font-size: clamp(2.1rem, 4vw, 4.2rem); font-weight: 400; letter-spacing: -.045em; line-height: .98; overflow-wrap: anywhere; text-wrap: balance; }
  .process-row p { max-width: 37ch; margin: 0; color: var(--nd-muted); line-height: 1.65; }
  .method-cta { padding: clamp(6rem, 12vw, 11rem) 0; background: var(--nd-ink-soft); }
  .method-cta__inner { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
  .method-cta h2 { grid-column: 2; }
  .method-cta .new-button { grid-column: 2; justify-self: start; margin-top: 1rem; }
  @media (max-width: 800px) {
    .process-row { grid-template-columns: 48px 1fr; gap: 1rem; }
    .process-row p { grid-column: 2; }
    .method-cta__inner { grid-template-columns: 1fr; }
    .method-cta h2, .method-cta .new-button { grid-column: auto; }
  }
</style>
