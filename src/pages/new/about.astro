---
import NewDirectionLayout from '../../layouts/NewDirectionLayout.astro';
import { type Lang, withBase } from '../../i18n/ui';
import { getNewDirectionCopy, newDirectionPath } from '../../data/newDirectionI18n';

interface Props { lang?: Lang; }
const { lang = 'pl' } = Astro.props as Props;
const c = getNewDirectionCopy(lang);
const p = (path = '') => withBase(newDirectionPath(lang, path));
const [essayTitleFirst, essayTitleSecond] = c.about.essayTitle.split('\n');
---

<NewDirectionLayout title={c.layout.nav.about} description={c.about.lede} current="about" lang={lang} currentPath="about">
  <section class="new-page-hero new-shell">
    <div class="new-page-hero__grid nd-reveal">
      <span class="new-meta">03 — {c.layout.nav.about}</span>
      <div>
        <h1 class="new-page-title">Daniil<br /><em>Menshov.</em></h1>
        <p class="new-page-lede">{c.about.lede}</p>
      </div>
    </div>
  </section>

  <section class="about-essay new-shell">
    <div class="about-essay__label nd-reveal">
      <span class="new-meta">{c.about.label.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</span>
    </div>
    <div class="about-essay__text nd-reveal">
      <h2>{essayTitleFirst}<br />{essayTitleSecond} <em>{c.about.essayAccent}</em></h2>
      {c.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="stack new-shell" aria-labelledby="stack-title">
    <div class="stack__head nd-reveal">
      <span class="new-meta">{c.about.stackMeta}</span>
      <h2 id="stack-title" class="new-section-title">{c.about.stackTitle}<br /><em>{c.about.stackAccent}</em></h2>
    </div>
    <dl class="stack__list nd-reveal">
      {c.about.stack.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </section>

  <section class="about-cta">
    <div class="new-shell nd-reveal">
      <a class="new-button" href={p('contact')}>{c.about.cta} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</NewDirectionLayout>

<style>
  .about-essay { display: grid; grid-template-columns: minmax(170px, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 10vw, 11rem); padding: 0 0 clamp(8rem, 16vw, 15rem); }
  .about-essay__label { display: flex; align-items: start; }
  .about-essay__text { max-width: 680px; }
  .about-essay h2 { margin: 0; font-family: var(--nd-serif); font-size: clamp(3.2rem, 6vw, 6.5rem); font-weight: 400; letter-spacing: -.04em; line-height: 1; overflow-wrap: anywhere; text-wrap: balance; }
  .about-essay h2 em { color: var(--nd-accent); }
  .about-essay p { max-width: 48ch; margin: 2rem 0 0; color: var(--nd-muted); font-size: 1.04rem; line-height: 1.7; }
  .stack { display: grid; grid-template-columns: minmax(300px, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); padding: clamp(6rem, 12vw, 11rem) 0; border-top: 1px solid var(--nd-line); }
  .stack__list { margin: 0; border-top: 1px solid var(--nd-line); }
  .stack__list div { display: grid; grid-template-columns: minmax(130px, .7fr) 1.3fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--nd-line); }
  .stack dt { color: var(--nd-muted); font-family: var(--nd-mono); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  .stack dd { margin: 0; line-height: 1.5; }
  .about-cta { padding: 4rem 0 8rem; }
  @media (max-width: 800px) { .about-essay, .stack { grid-template-columns: 1fr; } }
  @media (max-width: 500px) { .stack__list div { grid-template-columns: 1fr; gap: .35rem; } }
</style>
