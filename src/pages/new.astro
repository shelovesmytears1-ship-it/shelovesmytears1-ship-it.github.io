---
import { getCollection } from 'astro:content';
import { type Lang, withBase } from '../i18n/ui';
import { getNewDirectionCopy, newDirectionLanguages, newDirectionPath } from '../data/newDirectionI18n';

const entries = await getCollection('cases');
const bySlug = new Map(entries.map((entry) => [entry.slug, entry]));
const selectedSlugs = ['prezfull', 'wavemetrics', 'interspace'] as const;
const projects = selectedSlugs
  .map((slug) => bySlug.get(slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
interface Props { lang?: Lang; }
const { lang = 'pl' } = Astro.props as Props;
const c = getNewDirectionCopy(lang);
const p = (path = '') => withBase(newDirectionPath(lang, path));
const projectSummary = (project: (typeof projects)[number]) => {
  const localized = lang === 'ru' ? undefined : project.data.translations?.[lang];
  return localized?.summary ?? project.data.summary;
};
---

<!doctype html>
<html lang={lang === 'ua' ? 'uk' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121315" />
    <meta name="robots" content="noindex, nofollow" />
    <title>overflow — {c.layout.footer}</title>
    <meta
      name="description"
      content={c.home.heroBody}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">{c.layout.skip}</a>

    <header class="nav" data-nav>
      <a class="brand" href={p()} aria-label="overflow">overflow<span>.</span></a>
      <nav class="nav__links" aria-label={c.layout.mainNavigation}>
        <a href={p('work')}>{c.layout.nav.work}</a>
        <a href={p('method')}>{c.layout.nav.method}</a>
        <a href={p('about')}>{c.layout.nav.about}</a>
      </nav>
      <div class="nav__right">
        <div class="language-switch" aria-label={c.layout.languageLabel}>
          {newDirectionLanguages.map((locale) => (
            <a
              class:list={[locale === lang && 'is-active']}
              href={withBase(newDirectionPath(locale))}
              hreflang={locale === 'ua' ? 'uk' : locale}
              aria-current={locale === lang ? 'page' : undefined}
            >{locale.toUpperCase()}</a>
          ))}
        </div>
        <a class="nav__contact" href={p('contact')}>{c.layout.nav.talk} <span aria-hidden="true">↗</span></a>
      </div>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        {c.layout.nav.menu}
      </button>
      <nav class="mobile-menu" id="mobile-menu" aria-label={c.layout.mobileNavigation} data-menu hidden>
        <a href={p('work')}>{c.layout.nav.work}</a>
        <a href={p('method')}>{c.layout.nav.method}</a>
        <a href={p('about')}>{c.layout.nav.about}</a>
        <a href={p('contact')}>{c.layout.nav.contact}</a>
        <div class="mobile-languages" aria-label={c.layout.languageLabel}>
          {newDirectionLanguages.map((locale) => (
            <a class:list={[locale === lang && 'is-active']} href={withBase(newDirectionPath(locale))}>{locale.toUpperCase()}</a>
          ))}
        </div>
      </nav>
    </header>

    <main id="content">
      <section class="hero" id="top">
        <div class="shell hero__grid">
          <div class="hero__topline reveal">
            <span class="meta">{c.home.meta}</span>
            <span class="meta">{c.home.location}</span>
          </div>

          <div class="hero__content">
          <h1 class="hero__title reveal">
            {c.home.heroTitle}
            <em>{c.home.heroAccent}</em> {c.home.heroTail}
          </h1>

          <div class="hero__bottom reveal">
            <p>
              {c.home.heroBody}
            </p>
            <a class="button button--primary" href="#contact">
              {c.home.heroCta} <span aria-hidden="true">↘</span>
            </a>
          </div>
          </div>

          <aside class="hero__showcase reveal" aria-label={c.home.workMeta}>
            {projects.map((project, index) => (
              <a class="hero-card" href={p(`work/${project.slug}`)} style={`--project-bg: ${project.data.bg || '#25272a'};`}>
                <span class="hero-card__num">0{index + 1}</span>
                <picture>
                  <source
                    type="image/webp"
                    srcset={`${withBase(project.data.cover.replace(/^\/covers\/(.+)\.jpe?g$/i, '/covers/4k/$1.webp'))} 3840w, ${withBase(project.data.cover.replace(/\.jpe?g$/i, '.webp'))} 1280w`}
                    sizes="(min-width: 921px) 320px, 42vw"
                  />
                  <img
                    src={withBase(project.data.cover)}
                    alt=""
                    width="1280"
                    height="800"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </picture>
                <span class="hero-card__title">{project.data.title}</span>
              </a>
            ))}
          </aside>
        </div>
        <div class="hero__index" aria-hidden="true">01 / 01</div>
      </section>

      <section class="intro shell" aria-label={c.home.introMeta}>
        <span class="meta reveal">{c.home.introMeta}</span>
        <p class="intro__statement reveal">
          {c.home.intro}
        </p>
        <div class="intro__facts reveal" aria-label={c.home.introMeta}>
          {c.home.facts.map((fact) => <span>{fact}</span>)}
        </div>
      </section>

      <section class="work shell" id="work" aria-labelledby="work-title">
        <header class="section-head reveal">
          <span class="meta">{c.home.workMeta}</span>
          <div>
            <h2 id="work-title">{c.home.workTitle}<br /><em>{c.home.workAccent}</em></h2>
            <p>{c.home.workBody}</p>
          </div>
        </header>

        <div class="projects">
          {projects.map((project, index) => (
            <a
              class:list={['project', index % 2 === 1 && 'project--reversed', 'reveal']}
              href={p(`work/${project.slug}`)}
              aria-label={`${c.home.openProject} ${project.data.title}`}
              style={`--project-bg: ${project.data.bg || '#25272a'};`}
            >
              <div class="project__media">
                {project.data.cover && (
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`${withBase(project.data.cover.replace(/^\/covers\/(.+)\.jpe?g$/i, '/covers/4k/$1.webp'))} 3840w, ${withBase(project.data.cover.replace(/\.jpe?g$/i, '.webp'))} 1280w`}
                      sizes="(min-width: 960px) 32vw, 100vw"
                    />
                    <img
                      src={withBase(project.data.cover)}
                      alt=""
                      width="1280"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
                <span class="project__open" aria-hidden="true">↗</span>
              </div>
              <div class="project__copy">
                <span class="meta">0{index + 1} · {project.data.niche} · {project.data.year}</span>
                <h3>{project.data.title}</h3>
                <p>{projectSummary(project)}</p>
                <span class="project__link">{c.home.openProject} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <a class="text-link reveal" href={p('work')}>
          {c.home.allWork} <span aria-hidden="true">→</span>
        </a>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="shell">
          <header class="section-head section-head--process reveal">
            <span class="meta">{c.home.processMeta}</span>
            <h2 id="process-title">{c.home.processTitle}<br /><em>{c.home.processAccent}</em></h2>
          </header>

          <ol class="steps">
            {c.home.steps.map((step, index) => (
              <li class="step reveal">
                <span class="step__number">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="about shell" id="about" aria-labelledby="about-title">
        <div class="about__label reveal">
          <span class="meta">{c.home.aboutMeta}</span>
        </div>
        <div class="about__copy reveal">
          <h2 id="about-title">Daniil Menshov.</h2>
          <p>
            {c.home.aboutBody}
          </p>
          <a class="text-link" href={p('about')}>{c.home.aboutLink} <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="shell contact__inner">
          <span class="meta reveal">{c.home.contactMeta}</span>
          <h2 id="contact-title" class="reveal">{c.home.contactTitle}<br /><em>{c.home.contactAccent}</em></h2>
          <p class="reveal">{c.home.contactBody}</p>
          <div class="contact__actions reveal">
            <a class="button button--light" href={p('contact')}>{c.home.contactCta} <span aria-hidden="true">↗</span></a>
            <a class="contact__email" href="mailto:overflow.web1@gmail.com">overflow.web1@gmail.com</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer shell">
      <a class="brand" href={p()}>overflow<span>.</span></a>
      <p>{c.layout.footer}<br />© 2026</p>
      <a href="https://t.me/zzxvaracaa" target="_blank" rel="noopener">Telegram ↗</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');

      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealItems.forEach((item) => observer.observe(item));
      }

      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-menu]');
      const closeMenu = () => {
        if (!menuButton || !mobileMenu) return;
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('hidden', '');
      };

      menuButton?.addEventListener('click', () => {
        if (!mobileMenu) return;
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        mobileMenu.toggleAttribute('hidden', isOpen);
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #121315;
    --ink-soft: #1b1d20;
    --ink-raised: #25272a;
    --paper: #f1efe8;
    --muted: #a2a39d;
    --line: rgba(241, 239, 232, 0.18);
    --accent: #c96a2b;
    --shell: min(1320px, calc(100vw - 64px));
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'Inter', Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--ink); }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  .shell { width: var(--shell); margin-inline: auto; }
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 10px 14px;
    color: var(--ink);
    background: var(--paper);
    transform: translateY(-180%);
  }
  .skip-link:focus { transform: translateY(0); }
  :focus-visible { outline: 2px solid var(--paper); outline-offset: 4px; }
  .meta {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .brand {
    color: var(--paper);
    font-family: var(--sans);
    font-size: 1.24rem;
    font-weight: 600;
    letter-spacing: -0.07em;
  }
  .brand span { color: var(--accent); }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    height: 76px;
    padding-inline: max(32px, calc((100vw - 1320px) / 2));
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgba(18, 19, 21, 0.92), rgba(18, 19, 21, 0));
    backdrop-filter: blur(0);
  }
  .nav__links { display: flex; gap: 2rem; min-width: 0; }
  .nav__right { display: flex; justify-self: end; align-items: center; gap: 1.35rem; }
  .nav__links a, .nav__contact, .menu-button {
    color: var(--muted);
    font-size: 0.78rem;
    transition: color 180ms ease;
  }
  .nav__links a:hover, .nav__contact:hover, .menu-button:hover { color: var(--paper); }
  .language-switch { display: flex; align-items: center; gap: .18rem; padding: .16rem; border: 1px solid var(--line); border-radius: 999px; }
  .language-switch a { display: grid; min-width: 26px; min-height: 26px; padding: .2rem; place-items: center; color: var(--muted); font-family: var(--mono); font-size: .62rem; letter-spacing: .03em; }
  .language-switch a:hover, .language-switch a.is-active { color: var(--ink); background: var(--paper); border-radius: 999px; }
  .nav__contact span { color: var(--accent); }
  .menu-button, .mobile-menu { display: none; }

  .hero {
    position: relative;
    display: grid;
    align-items: stretch;
    height: 100dvh;
    min-height: 100svh;
    box-sizing: border-box;
    overflow: clip;
    padding: 112px 0 38px;
  }
  .hero::before {
    position: absolute;
    top: 11%;
    left: 42%;
    width: min(48vw, 620px);
    aspect-ratio: 1;
    border: 1px solid rgba(241, 239, 232, 0.08);
    border-radius: 50%;
    content: '';
    transform: translateX(-10%);
  }
  .hero::after {
    position: absolute;
    right: -8vw;
    bottom: -18vw;
    width: min(34vw, 460px);
    aspect-ratio: 1;
    border: 1px solid rgba(201, 106, 43, 0.4);
    border-radius: 50%;
    content: '';
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(260px, 28vw, 390px);
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: clamp(2rem, 6vw, 7.5rem);
    height: 100%;
  }
  .hero__topline {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(1.25rem, 4vh, 3.2rem);
  }
  .hero__content {
    align-self: end;
    padding-bottom: clamp(0.5rem, 2.6vh, 2rem);
  }
  .hero__title {
    max-width: 980px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(4.2rem, 8.2vw, 9.1rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.94;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .hero__title em, h2 em, .intro__statement em { color: var(--accent); font-weight: inherit; }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    max-width: 760px;
    margin-top: clamp(2rem, 5vh, 4.4rem);
    margin-left: 0;
  }
  .hero__bottom p {
    max-width: 380px;
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 222px;
    gap: 1.5rem;
    padding: 1rem 1.15rem 1rem 1.3rem;
    border: 1px solid var(--accent);
    font-size: 0.8rem;
    font-weight: 500;
    transition: transform 220ms ease, background 220ms ease, color 220ms ease;
  }
  .button span { color: var(--accent); font-size: 1.1rem; transition: transform 220ms ease; }
  .button:hover { background: var(--accent); color: var(--ink); transform: translateY(-3px); }
  .button:hover span { color: inherit; transform: translate(3px, -3px); }
  .hero__index {
    position: absolute;
    right: max(32px, calc((100vw - 1320px) / 2));
    bottom: 14px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
  }

  /* A 1280×720 laptop must still show the entire first screen. */
  .hero__showcase {
    align-self: end;
    display: grid;
    gap: 0.8rem;
    padding-bottom: clamp(0.5rem, 2.8vh, 2.2rem);
  }
  .hero-card {
    position: relative;
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    min-height: clamp(74px, 11vh, 118px);
    padding: 0.65rem;
    border: 1px solid rgba(241, 239, 232, 0.16);
    background: rgba(241, 239, 232, 0.035);
    transition: border-color 180ms ease, background 180ms ease, transform 220ms ease;
  }
  .hero-card:hover {
    border-color: rgba(201, 106, 43, 0.58);
    background: rgba(241, 239, 232, 0.06);
    transform: translateY(-3px);
  }
  .hero-card__num {
    position: absolute;
    top: 0.55rem;
    right: 0.65rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }
  .hero-card picture {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--project-bg);
  }
  .hero-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-card__title {
    max-width: 15ch;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  @media (min-width: 921px) and (max-height: 840px) {
    .hero { padding: 86px 0 26px; }
    .hero__topline { padding-bottom: clamp(0.8rem, 2.4vh, 1.6rem); }
    .hero__title { font-size: clamp(3.55rem, 7.45vw, 6.35rem); line-height: 0.93; }
    .hero__bottom { margin-top: clamp(1.25rem, 2.6vh, 2.1rem); }
    .hero__bottom p { font-size: 0.88rem; line-height: 1.55; }
    .button { min-width: 196px; padding: 0.84rem 1rem; }
    .hero-card { grid-template-columns: 76px minmax(0, 1fr); min-height: clamp(66px, 10vh, 88px); }
    .hero-card__title { font-size: clamp(1.05rem, 1.6vw, 1.35rem); }
  }

  .intro { padding: clamp(7rem, 15vw, 14rem) 0; }
  .intro__statement {
    max-width: 1060px;
    margin: 2rem 0 3rem;
    font-family: var(--serif);
    font-size: clamp(2.25rem, 4.8vw, 5.7rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .intro__facts { display: flex; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .intro__facts span {
    flex: 1;
    padding: 1rem 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .intro__facts span + span { padding-left: 1rem; border-left: 1px solid var(--line); }

  .work { padding-bottom: clamp(8rem, 16vw, 15rem); }
  .section-head {
    display: grid;
    grid-template-columns: minmax(170px, 1fr) 2fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(3.5rem, 7vw, 7rem);
  }
  .section-head h2, .about h2, .contact h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.2rem, 6.7vw, 7.4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .section-head p { max-width: 340px; margin: 1.75rem 0 0; color: var(--muted); font-size: 0.94rem; line-height: 1.6; }
  .projects { display: flex; flex-direction: column; }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);
    grid-template-areas: 'media copy';
    gap: clamp(1.5rem, 6vw, 7rem);
    align-items: center;
    padding: clamp(2.5rem, 5vw, 5rem) 0;
    border-top: 1px solid var(--line);
  }
  .project:last-child { border-bottom: 1px solid var(--line); }
  .project--reversed {
    grid-template-columns: minmax(260px, 0.55fr) minmax(0, 1.45fr);
    grid-template-areas: 'copy media';
  }
  .project__media {
    grid-area: media;
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    place-items: center;
    background: var(--project-bg);
  }
  .project__media picture, .project__media img { display: block; width: 100%; height: 100%; }
  .project__media img { object-fit: contain; object-position: center; }
  .project__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(18, 19, 21, 0.23), transparent 55%);
    content: '';
    pointer-events: none;
    transition: opacity 350ms ease;
  }
  .project__open {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 1;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--ink);
    background: var(--paper);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 250ms ease, transform 250ms ease;
  }
  .project:hover .project__media::after { opacity: 0; }
  .project:hover .project__open { opacity: 1; transform: translateY(0); }
  .project__copy { grid-area: copy; }
