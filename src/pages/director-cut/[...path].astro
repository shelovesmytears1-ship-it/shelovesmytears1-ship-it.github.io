---
import { getCollection, type CollectionEntry } from 'astro:content';
import { withBase } from '../../i18n/ui';
import { getSummary } from '../../data/caseHelpers';

type Props =
  | { kind: 'page'; page: 'work' | 'method' | 'about' | 'contact' }
  | { kind: 'case'; caseStudy: CollectionEntry<'cases'> };

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return [
    ...(['work', 'method', 'about', 'contact'] as const).map((page) => ({ params: { path: page }, props: { kind: 'page', page } })),
    ...cases.map((caseStudy) => ({ params: { path: `work/${caseStudy.slug}` }, props: { kind: 'case', caseStudy } })),
  ];
}

const props = Astro.props as Props;
const allCases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const isCase = props.kind === 'case';
const page = isCase ? 'work' : props.page;
const caseStudy = isCase ? props.caseStudy : undefined;
const rendered = caseStudy ? await caseStudy.render() : undefined;
const Content = rendered?.Content;
const titleMap = { work: 'Работы', method: 'Подход', about: 'Обо мне', contact: 'Контакт' } as const;
const title = caseStudy ? caseStudy.data.title : titleMap[page];
const toCover = (cover: string) => withBase(cover);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090b" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — overflow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" />
  </head>
  <body>
    <a class="skip" href="#content">К содержанию</a>
    <header class="nav shell">
      <a class="brand" href="/director-cut/" aria-label="overflow">overflow<span>.</span></a>
      <nav aria-label="Навигация">
        <a class:list={[page === 'work' && !isCase && 'active']} href="/director-cut/work/">Работы</a>
        <a class:list={[page === 'method' && 'active']} href="/director-cut/method/">Подход</a>
        <a class:list={[page === 'about' && 'active']} href="/director-cut/about/">Обо мне</a>
      </nav>
      <a class="talk" href="/director-cut/contact/">Начать проект ↗</a>
    </header>

    <main id="content">
      {isCase && caseStudy ? (
        <>
          <section class="case-hero shell">
            <a class="back" href="/director-cut/work/">← Все работы</a>
            <p class="eyebrow">{caseStudy.data.niche} · {caseStudy.data.year}</p>
            <h1>{caseStudy.data.title}</h1>
            <p class="lead">{getSummary(caseStudy, 'ru')}</p>
            {caseStudy.data.cover && <img class="case-cover" src={toCover(caseStudy.data.cover)} alt="" width="3840" height="2400" />}
          </section>
          <article class="case-body shell">
            {Content && <Content />}
          </article>
        </>
      ) : page === 'work' ? (
        <>
          <section class="page-hero shell"><p class="eyebrow">01 — Selected work</p><h1>Работы, которые<br /><em>работают на память.</em></h1><p class="lead">Каждый проект получает свой ритм, систему и способ говорить с аудиторией.</p></section>
          <section class="case-list shell" aria-label="Кейсы">
            {allCases.map((project, index) => (
              <article class:list={['case-row', index % 2 && 'case-row--reverse']}>
                <a href={`/director-cut/work/${project.slug}/`} class="case-row__visual" style={`--project-bg: ${project.data.bg || '#171a20'};`} aria-label={`Открыть ${project.data.title}`}>
                  {project.data.cover && <img src={toCover(project.data.cover)} alt="" width="3840" height="2400" loading="lazy" />}
                  <span>↗</span>
                </a>
                <div class="case-row__copy"><p class="eyebrow">{String(index + 1).padStart(2, '0')} · {project.data.niche} · {project.data.year}</p><h2>{project.data.title}</h2><p>{getSummary(project, 'ru')}</p></div>
              </article>
            ))}
          </section>
        </>
      ) : page === 'method' ? (
        <>
          <section class="page-hero shell"><p class="eyebrow">02 — The approach</p><h1>Ясность до формы.<br /><em>Форма до шума.</em></h1><p class="lead">Процесс остаётся прозрачным: от задачи к решению, от решения к сайту, который можно измерить.</p></section>
          <section class="method shell"><ol>{[['01','Рамка','Цели, аудитория, ограничения и честный масштаб задачи.'],['02','Направление','Один сильный характер вместо набора случайных референсов.'],['03','Система','Ключевые экраны и движения сразу в браузере — на реальном контенте.'],['04','Релиз','Скорость, адаптив, SEO-основа и проверка перед запуском.']].map(([num, name, text]) => <li><span>{num}</span><h2>{name}</h2><p>{text}</p></li>)}</ol></section>
        </>
      ) : page === 'about' ? (
        <section class="about shell"><p class="eyebrow">03 — About</p><h1>Дизайн и код<br /><em>в одном контуре.</em></h1><div><p class="lead">Я работаю как независимый frontend-разработчик: исследую задачу, создаю визуальную концепцию и собираю её в быстрый, адаптивный сайт.</p><p>Это сокращает путь от идеи к живому продукту — без потери деталей между дизайном и реализацией.</p><a class="button" href="/director-cut/contact/">Обсудить задачу ↗</a></div></section>
      ) : (
        <section class="contact shell"><p class="eyebrow">04 — Contact</p><h1>Сделаем не<br /><em>как у всех.</em></h1><p class="lead">Опиши проект, рынок и сроки. Я отвечу с вопросами, возможным направлением и следующим шагом.</p><div class="contact-actions"><a class="button" href="https://t.me/zzxvaracaa" target="_blank" rel="noopener">Написать в Telegram ↗</a><a href="mailto:overflow.web1@gmail.com">overflow.web1@gmail.com</a></div></section>
      )}
    </main>
    <footer class="footer shell"><a class="brand" href="/director-cut/">overflow<span>.</span></a><span>Director's cut · 2026</span><a href="/">Current version ↗</a></footer>
  </body>
</html>

<style>
  :root { --ink:#08090b; --paper:#f5f2ea; --mist:#b8b8b3; --line:rgba(245,242,234,.18); --acid:#e8ff56; --rose:#ff6e92; --shell:min(1240px, calc(100vw - 48px)); }
  *,*::before,*::after{box-sizing:border-box} html{background:var(--ink);overflow-x:clip} body{margin:0;background:var(--ink);color:var(--paper);font-family:'Space Grotesk',sans-serif;overflow-x:clip} a{color:inherit;text-decoration:none} img{display:block;max-width:100%}.shell{width:var(--shell);margin-inline:auto}.skip{position:fixed;top:10px;left:10px;z-index:10;padding:.7rem 1rem;background:var(--acid);color:var(--ink);transform:translateY(-180%)}.skip:focus{transform:none}:focus-visible{outline:2px solid var(--acid);outline-offset:4px}.nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:82px}.brand{font:800 1.2rem Archivo,sans-serif;letter-spacing:-.08em}.brand span{color:var(--acid)}.nav nav{display:flex;gap:1.5rem;font-size:.7rem;color:var(--mist)}.nav nav a{padding:.45rem 0}.nav nav a:hover,.nav nav .active{color:var(--acid)}.talk{justify-self:end;font-size:.72rem}.eyebrow{margin:0;color:var(--acid);font:500 .64rem 'DM Mono',monospace;letter-spacing:.08em;line-height:1.5;text-transform:uppercase}.page-hero,.case-hero{padding:clamp(6rem,13vw,12rem) 0 clamp(4rem,8vw,7rem)}h1,h2,p{margin-top:0}h1{max-width:12ch;margin:.8rem 0 2rem;font:600 clamp(3.35rem,8.5vw,8.2rem) Archivo,sans-serif;letter-spacing:-.09em;line-height:.84}h1 em{color:var(--rose);font-style:normal}.lead{max-width:43ch;color:var(--mist);font-size:1rem;line-height:1.65}.case-list{padding-bottom:clamp(7rem,12vw,12rem)}.case-row{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(240px,.65fr);grid-template-areas:'visual copy';gap:clamp(1.5rem,6vw,6rem);align-items:center;padding:clamp(2.5rem,5vw,5rem) 0;border-top:1px solid var(--line)}.case-row--reverse{grid-template-columns:minmax(240px,.65fr) minmax(0,1.35fr);grid-template-areas:'copy visual'}.case-row:last-child{border-bottom:1px solid var(--line)}.case-row__visual{grid-area:visual;position:relative;display:block;overflow:hidden;aspect-ratio:16/10;background:var(--project-bg)}.case-row__visual img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .7s cubic-bezier(.16,1,.3,1)}.case-row__visual:hover img{transform:scale(1.04)}.case-row__visual span{position:absolute;right:14px;bottom:14px;display:grid;width:44px;height:44px;place-items:center;background:var(--acid);color:var(--ink);border-radius:50%;opacity:0;transform:translateY(8px);transition:.25s}.case-row__visual:hover span{opacity:1;transform:none}.case-row__copy{grid-area:copy;min-width:0}.case-row__copy h2,.method h2{margin:.65rem 0 1rem;font:600 clamp(2rem,3.8vw,4rem) Archivo,sans-serif;letter-spacing:-.08em;line-height:.88}.case-row__copy>p:last-child{max-width:34ch;margin:0;color:var(--mist);font-size:.9rem;line-height:1.6}.method{padding-bottom:clamp(8rem,13vw,13rem)}.method ol{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;border-top:1px solid var(--line);border-left:1px solid var(--line);list-style:none}.method li{min-height:310px;padding:1.2rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.method li span{color:var(--acid);font:.65rem 'DM Mono',monospace}.method h2{margin-top:4rem;font-size:2rem}.method li p{margin:0;color:var(--mist);font-size:.84rem;line-height:1.6}.about,.contact{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(250px,.6fr);gap:clamp(2rem,9vw,9rem);align-items:start;min-height:70vh;padding:clamp(7rem,13vw,12rem) 0}.about>div{padding-top:5rem}.about>div>p:not(.lead){max-width:44ch;margin:1.5rem 0;color:var(--mist);line-height:1.65}.button{display:inline-block;margin-top:2rem;padding:1rem 1.25rem;background:var(--acid);color:var(--ink);font-size:.8rem;transition:transform .2s ease}.button:hover{transform:translateY(-3px)}.contact{display:block;min-height:72vh}.contact h1{font-size:clamp(4rem,10vw,10rem)}.contact-actions{display:flex;gap:2rem;align-items:center;margin-top:2.5rem;font:.75rem 'DM Mono',monospace}.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:center;padding:2rem 0;color:var(--mist);font:.6rem 'DM Mono',monospace;text-transform:uppercase}.footer>a:last-child{justify-self:end}@media(max-width:760px){:root{--shell:min(100% - 36px,1240px)}.nav{grid-template-columns:1fr auto;min-height:66px}.nav nav{position:absolute;top:66px;left:0;justify-content:space-between;width:100%;padding:.75rem 0;border-top:1px solid var(--line);font-size:.62rem}.talk{font-size:.66rem}.page-hero,.case-hero{padding-top:9rem}h1{font-size:clamp(3rem,13vw,5rem)}.case-row,.case-row--reverse{grid-template-columns:1fr;grid-template-areas:'visual' 'copy';gap:1.1rem}.case-row__visual span{opacity:1;transform:none}.method ol{grid-template-columns:1fr 1fr}.method li{min-height:240px}.method h2{margin-top:2.6rem}.about{grid-template-columns:1fr;min-height:auto}.about>div{padding-top:0}.contact{min-height:65vh}.footer{grid-template-columns:1fr auto}.footer span{display:none}}@media(max-width:430px){.method ol{grid-template-columns:1fr}.method li{min-height:190px}.contact-actions{align-items:start;flex-direction:column;gap:1rem}.contact h1{font-size:clamp(3.5rem,15vw,4.7rem)}}
</style>
