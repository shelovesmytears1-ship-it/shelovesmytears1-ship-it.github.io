---
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import CaseStudy from '../../../components/studio/CaseStudy.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({
    params: { slug: c.slug },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const lang = 'ua' as const;
const d = entry.data;
---
<StudioLayout title={`${d.title} — overflow`} description={d.summary} lang={lang} current="work">
  <CaseStudy lang={lang} entry={entry} />
</StudioLayout>
