---
import { getCollection } from 'astro:content';
import { useT, localePath, withBase } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
import { getSummary, nicheLabel } from '../../data/caseHelpers';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const p = (path: string) => localePath(path, lang);

/* Pull all case studies, sort by frontmatter order */
const allCases = await getCollection('cases');
const cases = allCases.sort((a, b) => a.data.order - b.data.order);
---

<!-- ═══════════════════════════════════════════════════════════
     HERO — full viewport height
═══════════════════════════════════════════════════════════════ -->
<section class="h-hero" data-hero>
  <div class="container h-hero__inner">
    <div class="h-hero__content">
      <span class="eyebrow" data-hero-item>{t('hero.eyebrow')}</span>
      <h1 class="h-hero__h1">
        <span class="h-hero__h1-line"><span data-hero-line>{t('hero.h1.line1')}</span></span>
        <span class="h-hero__h1-line h-hero__h1-line--accent"><span data-hero-line>{t('hero.h1.line2')}</span></span>
      </h1>
      <p class="h-hero__sub" data-hero-item>{t('hero.sub')}</p>
    </div>
    <a href="#works" class="h-hero__hook mono" data-hero-item>
      <span>{t('hero.hook')}</span>
    </a>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     LANDINGS BLOCK — anchor target for hero hook
═══════════════════════════════════════════════════════════════ -->
<section class="h-gallery section" id="works">
  <div class="container">
    <header class="h-gallery__head reveal">
      <h2 class="sr-only">{t('gallery.eyebrow')}</h2>
      <span class="eyebrow">{t('gallery.eyebrow')}</span>
      <p class="h-gallery__intro">{t('gallery.intro.p1')}</p>
      <p class="h-gallery__intro h-gallery__intro--muted">{t('gallery.intro.p2')}</p>
    </header>

    <div class="h-gallery__grid stagger">
      {cases.map((c) => (
        <a href={p(`/work/${c.slug}`)} class="g-card">
          <!-- Visual preview area — palette swatches as the differentiator -->
          <div
            class="g-card__visual"
            style={`--g-bg: ${c.data.bg || '#1A1410'}; --g-acc: ${c.data.accent || '#B25814'};`}
          >
            {c.data.cover ? (
              <picture>
                <source
                  type="image/webp"
                  srcset={`${withBase(c.data.cover.replace(/^\/covers\/(.+)\.jpe?g$/i, '/covers/4k/$1.webp'))} 3840w, ${withBase(c.data.cover.replace(/\.jpe?g$/i, '.webp'))} 1280w`}
                  sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw"
                />
                <img
                  src={withBase(c.data.cover)}
                  alt={`${c.data.title} hero preview`}
                  class="g-card__cover"
                  loading="lazy"
                  width="3840"
                  height="2400"
                />
              </picture>
            ) : (
              <div class="g-card__visual-inner">
                <div class="g-card__brand mono">{c.data.title.toLowerCase()}</div>
                <div class="g-card__sketch">
                  <em class="g-card__bar"></em>
                  <em class="g-card__line g-card__line--1"></em>
                  <em class="g-card__line g-card__line--2"></em>
                  <em class="g-card__pill"></em>
                </div>
              </div>
            )}
          </div>

          <!-- Card body -->
          <div class="g-card__body">
            <div class="g-card__meta">
              <span class="mono g-card__niche">{nicheLabel(c.data.niche, t)}</span>
              <span class="mono g-card__year">· {c.data.year}</span>
            </div>
            <h3 class="g-card__title">{c.data.title}</h3>
            <p class="g-card__summary">{getSummary(c, lang)}</p>
            <div class="g-card__footer">
              <span class="g-card__swatches" aria-hidden="true">
                <span class="g-card__swatch" style={`background: ${c.data.bg || '#1A1410'};`}></span>
                <span class="g-card__swatch" style={`background: ${c.data.accent || '#B25814'};`}></span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<hr class="divider" />

<!-- ═══════════════════════════════════════════════════════════
     ABOUT COMPACT
═══════════════════════════════════════════════════════════════ -->
<section class="h-about section">
  <div class="container">
    <div class="h-about__grid reveal">
      <div class="h-about__col-head">
        <span class="eyebrow">{t('about.compact.eyebrow')}</span>
        <h2 class="h-about__h2">{t('about.compact.h2')}</h2>
      </div>
      <div class="h-about__col-body">
        <p>{t('about.compact.body.p1')}</p>
        <p class="h-about__p-muted">{t('about.compact.body.p2')}</p>
        <a href={p('/about')} class="h-about__link mono">{t('about.compact.cta')}</a>
      </div>
    </div>
  </div>
</section>

<hr class="divider" />

<!-- ═══════════════════════════════════════════════════════════
     CONTACT TEASER
═══════════════════════════════════════════════════════════════ -->
<section class="h-contact section">
  <div class="container container--narrow h-contact__inner reveal">
    <span class="eyebrow">{t('contact.teaser.eyebrow')}</span>
    <h2 class="h-contact__h2">{t('contact.teaser.h2')}</h2>
    <p class="h-contact__sub">{t('contact.teaser.sub')}</p>
    <div class="h-contact__ctas">
      <a href={p('/contact')} class="btn btn--primary btn--lg">{t('contact.teaser.cta1')}</a>
      <a href="https://t.me/zzxvaracaa" target="_blank" rel="noopener" class="btn btn--ghost btn--lg">{t('contact.teaser.cta2')}</a>
    </div>
    <p class="h-contact__email mono">
      <a href="mailto:overflow.web1@gmail.com">{t('contact.teaser.cta3')}</a>
    </p>
  </div>
</section>


<style>
  /* ═══ HERO — full-viewport ═══ */
  .h-hero {
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100dvh - var(--nav-h));
    padding-top: var(--sp-md);
    padding-bottom: var(--sp-md);
    display: flex;
    align-items: stretch;
  }
  .h-hero__inner {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .h-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
  }
  .h-hero__h1 {
    margin-top: 1rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .h-hero__h1-line {
    display: block;
    overflow: hidden;
  }
  .h-hero__h1-line > span { display: block; }
  .h-hero__h1-line--accent {
    color: var(--accent);
    font-style: italic;
  }
  .h-hero__sub {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: 0;
  }
  /* Scroll-to-works hook — original look, clickable anchor */
  .h-hero__hook {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--sp-md);
    transition: color var(--dur-ui) ease;
    cursor: pointer;
  }
  .h-hero__hook span {
    display: inline-block;
    padding-right: 1.5rem;
    border-right: 1px solid var(--border2);
    margin-right: 1rem;
    transition: border-color var(--dur-ui) ease;
  }
  .h-hero__hook:hover {
    color: var(--accent);
  }
  .h-hero__hook:hover span {
    border-color: var(--accent);
  }
  @media (max-width: 600px) {
    .h-hero {
      min-height: calc(100vh - var(--nav-h));
      min-height: calc(100dvh - var(--nav-h));
    }
  }

  /* Scroll target offset for sticky header */
  :global(#works) {
    scroll-margin-top: var(--nav-h);
  }

  /* ═══ GALLERY ═══ */
  .h-gallery__head {
    margin-bottom: var(--sp-xl);
    max-width: 720px;
  }
  .h-gallery__intro {
    font-size: 1.0625rem;
    margin-top: 1rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .h-gallery__intro--muted {
    color: var(--muted);
  }

  .h-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-md);
  }
  @media (max-width: 900px) {
    .h-gallery__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .h-gallery__grid { grid-template-columns: 1fr; }
  }

  .g-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    color: var(--fg);
    transform: perspective(1000px) translate3d(0, 0, 0) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    will-change: transform;
    transition: border-color var(--dur-ui) ease, transform 260ms var(--ease), box-shadow var(--dur-ui) ease;
  }
  .g-card:hover {
    border-color: var(--border2);
    transform: perspective(1000px) translate3d(0, -4px, 0) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    box-shadow: 0 12px 32px rgba(var(--shadow-rgb), 0.05);
  }
  .g-card:hover .g-card__title { color: var(--accent); }

  .g-card__visual {
    /* 16:10 ratio matches standard browser hero screenshots (1280×800, 1600×1000).
       No cropping needed when source image is also 16:10. */
    background: var(--g-bg);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    width: 100%;
    padding-bottom: 62.5%; /* 10/16 = 0.625 = 62.5% */
    aspect-ratio: 16 / 10;
  }
  .g-card__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(260px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%), rgba(255, 255, 255, 0.32), transparent 55%);
    mix-blend-mode: soft-light;
    transition: opacity 220ms ease;
  }
  .g-card.is-tilting .g-card__visual::after { opacity: 1; }
  @supports (aspect-ratio: 1) {
    .g-card__visual { padding-bottom: 0; }
  }
  .g-card__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Image is 16:10 matching the container — no cropping needed.
       Cover (vs contain) ensures any minor pixel-rounding still fills. */
    object-fit: cover;
    object-position: top left;
    display: block;
    transition: transform 400ms var(--ease);
  }
  .g-card:hover .g-card__cover {
    transform: scale(1.015);
  }
  .g-card__visual-inner {
    position: absolute;
    inset: 0;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .g-card__brand {
    color: var(--g-acc);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    opacity: 0.95;
  }
  .g-card__sketch {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
  }
  .g-card__bar {
    width: 38%;
    height: 5px;
    border-radius: 2px;
    background: var(--g-acc);
    opacity: 0.85;
  }
  .g-card__line {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
  }
  .g-card__line--1 { width: 70%; }
  .g-card__line--2 { width: 50%; }
  .g-card__pill {
    margin-top: 0.3rem;
    width: 28%;
    height: 14px;
    border-radius: 3px;
    background: var(--g-acc);
    opacity: 0.9;
  }
  /* For light-bg projects, swap the line color so it's visible */
  .g-card__visual[style*="#FAFAF8"] .g-card__line,
  .g-card__visual[style*="#F8F4ED"] .g-card__line,
  .g-card__visual[style*="#FFFFFF"] .g-card__line,
  .g-card__visual[style*="#F4F4EE"] .g-card__line,
  .g-card__visual[style*="#F5F1E8"] .g-card__line,
  .g-card__visual[style*="#F8F4EC"] .g-card__line {
    background: rgba(26, 20, 14, 0.15);
  }

  .g-card__body {
    padding: 1.25rem 1.35rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .g-card__meta {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .g-card__niche {
    color: var(--accent);
  }
  .g-card__title {
    font-size: 1.5rem;
    margin: 0.1rem 0 0;
    transition: color var(--dur-ui) ease;
  }
  .g-card__summary {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: none;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(3 * 0.9375rem * 1.55);
  }
  .g-card__footer {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
  }
  .g-card__swatches {
    display: flex;
    gap: 0.35rem;
  }
  .g-card__swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid var(--border);
    display: inline-block;
  }

  .g-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  @media (hover: none), (pointer: coarse) {
    .g-card { will-change: auto; }
    .g-card__visual::after { display: none; }
  }

  /* ═══ ABOUT COMPACT ═══ */
  .h-about__grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--sp-lg);
    align-items: start;
  }
  @media (max-width: 720px) {
    .h-about__grid { grid-template-columns: 1fr; gap: var(--sp-md); }
  }
  .h-about__h2 {
    margin-top: 0.5rem;
  }
  .h-about__col-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .h-about__col-body p {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 60ch;
  }
  .h-about__p-muted { color: var(--muted); }
  .h-about__link {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    align-self: flex-start;
    transition: opacity var(--dur-ui) ease;
  }
  .h-about__link:hover { opacity: 0.7; }

  /* ═══ CONTACT TEASER ═══ */
  .h-contact__inner {
    text-align: center;
  }
  .h-contact__h2 {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .h-contact__sub {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 55ch;
  }
  .h-contact__ctas {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .h-contact__email {
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-align: center;
    display: block;
    margin: 0 auto;
    width: fit-content;
  }
  .h-contact__email a {
    border-bottom: 1px solid var(--border2);
    transition: color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }
  .h-contact__email a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

</style>
