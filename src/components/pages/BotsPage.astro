---
import { useT, localePath } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const p = (path: string) => localePath(path, lang);

const caps = [
  { h: t('bots.cap1.h'), d: t('bots.cap1.d') },
  { h: t('bots.cap2.h'), d: t('bots.cap2.d') },
  { h: t('bots.cap3.h'), d: t('bots.cap3.d') },
  { h: t('bots.cap4.h'), d: t('bots.cap4.d') },
  { h: t('bots.cap5.h'), d: t('bots.cap5.d') },
  { h: t('bots.cap6.h'), d: t('bots.cap6.d') },
];

const steps = [
  { n: '01', h: t('bots.step1.h'), d: t('bots.step1.d') },
  { n: '02', h: t('bots.step2.h'), d: t('bots.step2.d') },
  { n: '03', h: t('bots.step3.h'), d: t('bots.step3.d') },
];
---

<!-- Hero -->
<section class="b-hero">
  <div class="container b-hero__inner reveal">
    <span class="eyebrow">{t('bots.eyebrow')}</span>
    <h1 class="b-hero__h1">{t('bots.h1')}</h1>
    <p class="b-hero__sub">{t('bots.sub')}</p>
    <div class="b-hero__ctas">
      <a href={p('/contact')} class="btn btn--primary btn--lg">{t('bots.hero.cta')}</a>
      <a href="https://t.me/zzxvaracaa" target="_blank" rel="noopener" class="btn btn--ghost btn--lg">{t('contact.teaser.cta2')}</a>
    </div>
  </div>
</section>

<hr class="divider" />

<!-- What a bot can do -->
<section class="b-what section">
  <div class="container">
    <header class="b-what__head reveal">
      <span class="eyebrow">{t('bots.what.eyebrow')}</span>
      <h2 class="b-what__h2">{t('bots.what.h2')}</h2>
    </header>
    <div class="b-cards stagger">
      {caps.map((c) => (
        <div class="b-card">
          <h3 class="b-card__h">{c.h}</h3>
          <p class="b-card__d">{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<hr class="divider" />

<!-- How I work -->
<section class="b-how section">
  <div class="container b-how__grid reveal">
    <div class="b-how__col-head">
      <span class="eyebrow">{t('bots.how.eyebrow')}</span>
      <h2 class="b-how__h2">{t('bots.how.h2')}</h2>
    </div>
    <div class="b-how__col-body">
      <p>{t('bots.how.p1')}</p>
      <p class="b-how__p-muted">{t('bots.how.p2')}</p>
    </div>
  </div>
</section>

<hr class="divider" />

<!-- 3 steps -->
<section class="b-steps section">
  <div class="container">
    <span class="eyebrow b-steps__eyebrow reveal">{t('bots.steps.eyebrow')}</span>
    <ol class="b-steps__list stagger">
      {steps.map((s) => (
        <li class="b-step">
          <span class="mono b-step__num">{s.n}</span>
          <h3 class="b-step__h">{s.h}</h3>
          <p class="b-step__d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<hr class="divider" />

<!-- CTA -->
<section class="b-cta section">
  <div class="container container--narrow b-cta__inner reveal">
    <h2 class="b-cta__h2">{t('bots.cta.h')}</h2>
    <p class="b-cta__body">{t('bots.cta.body')}</p>
    <a href={p('/contact')} class="btn btn--primary btn--lg">{t('bots.cta.btn')}</a>
  </div>
</section>


<style>
  /* ═══ Hero ═══ */
  .b-hero {
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-lg);
  }
  .b-hero__inner { max-width: 800px; }
  .b-hero__h1 { margin-top: 0.5rem; margin-bottom: 1.5rem; }
  .b-hero__sub {
    font-size: 1.25rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 2rem;
    max-width: 60ch;
  }
  .b-hero__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ═══ What a bot can do — capability cards ═══ */
  .b-what__head {
    margin-bottom: var(--sp-lg);
    max-width: 720px;
  }
  .b-what__h2 { margin-top: 0.75rem; }
  .b-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-md);
  }
  @media (max-width: 900px) {
    .b-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .b-cards { grid-template-columns: 1fr; }
  }
  .b-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1.5rem 1.5rem 1.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color var(--dur-ui) ease, transform var(--dur-ui) ease, box-shadow var(--dur-ui) ease;
  }
  .b-card:hover {
    border-color: var(--border2);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(var(--shadow-rgb), 0.05);
  }
  .b-card__h {
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .b-card__d {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ═══ How I work ═══ */
  .b-how__grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--sp-lg);
    align-items: start;
  }
  @media (max-width: 720px) {
    .b-how__grid { grid-template-columns: 1fr; gap: var(--sp-md); }
  }
  .b-how__h2 { margin-top: 0.75rem; }
  .b-how__col-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .b-how__col-body p {
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 60ch;
  }
  .b-how__p-muted { color: var(--muted); }

  /* ═══ 3 steps ═══ */
  .b-steps__eyebrow {
    display: block;
    margin-bottom: var(--sp-md);
  }
  .b-steps__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-md);
    padding: 0;
    margin: 0;
  }
  @media (max-width: 720px) {
    .b-steps__list { grid-template-columns: 1fr; gap: var(--sp-lg); }
  }
  .b-step {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .b-step__num {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--accent);
    font-family: var(--font-display);
    font-style: italic;
  }
  .b-step__h {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }
  .b-step__d {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 40ch;
  }

  /* ═══ CTA ═══ */
  .b-cta__inner { text-align: center; }
  .b-cta__h2 { margin-bottom: 1rem; }
  .b-cta__body {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 50ch;
  }
</style>
