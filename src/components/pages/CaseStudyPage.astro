---
import type { CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { useT, localePath, withBase } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
import { getTagline, getSummary, getBody, getResult, getStat, nicheLabel } from '../../data/caseHelpers';
import JsonLd from '../JsonLd.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'cases'>;
}

const { lang, entry } = Astro.props;
const t = useT(lang);
const p = (path: string) => localePath(path, lang);

const d = entry.data;
const caseUrl = new URL(p(`/work/${entry.slug}`), 'https://overflow-web.pl').toString();

/* Split markdown body into sections at every `^## ` heading.
   Each section becomes a full-block on the page. */
type CaseSection = { heading: string; html: string };

function parseSections(body: string): CaseSection[] {
  /* Strip the frontmatter is already done by Astro — entry.body is just markdown content. */
  const parts = body.split(/^## /m).map(s => s.trim()).filter(Boolean);
  return parts.map(part => {
    const firstLineEnd = part.indexOf('\n');
    const heading = firstLineEnd === -1 ? part : part.slice(0, firstLineEnd).trim();
    const bodyMd = firstLineEnd === -1 ? '' : part.slice(firstLineEnd + 1).trim();
    const html = marked.parse(bodyMd, { async: false }) as string;
    return { heading, html };
  });
}

const sections = parseSections(getBody(entry, lang));
const result = getResult(entry, lang);
const stat = getStat(entry, lang);
/* Where to inject the stat callout: between section 1 (Контекст) and 2 (Решение).
   If the case has 3 sections, that's right after the first one. */
const statAfterIndex = sections.length > 1 ? 0 : -1;
---

<JsonLd
  type="case"
  lang={lang}
  caseData={{
    title: d.title,
    summary: getSummary(entry, lang),
    year: d.year,
    niche: d.niche,
    url: caseUrl,
  }}
/>

<article class="cs">

  <!-- Back nav -->
  <div class="container cs__back-bar">
    <a href={p('/work')} class="cs__back mono">{t('case.back')}</a>
  </div>

  <!-- Header / meta -->
  <header class="cs__hero">
    <div class="container cs__hero-inner reveal">
      <div class="cs__meta">
        <span class="mono cs__meta-niche">{nicheLabel(d.niche, t)}</span>
        <span class="mono cs__meta-sep">·</span>
        <span class="mono">{d.year}</span>
        {d.region[0] && (
          <>
            <span class="mono cs__meta-sep">·</span>
            <span class="mono">{d.region.join(' · ')}</span>
          </>
        )}
        {d.technologies.length > 0 && (
          <>
            <span class="mono cs__meta-sep">·</span>
            <span class="mono cs__meta-tech">{d.technologies.join(' / ')}</span>
          </>
        )}
        {result && (
          <>
            <span class="mono cs__meta-sep">·</span>
            <span class="mono cs__meta-result">→ {result}</span>
          </>
        )}
      </div>

      <h1 class="cs__title">{d.title}</h1>
      <p class="cs__tagline">{getTagline(entry, lang)}</p>

      {d.siteUrl && (
        <div class="cs__chips">
          <a href={d.siteUrl} target="_blank" rel="noopener" class="cs__chip cs__chip--link mono">
            {t('case.site')} ↗
          </a>
        </div>
      )}
    </div>
  </header>

  {/* Big visual lead — the case is now image-first */}
  {d.cover && (
    <section class="cs__visual">
      <div class="container container--wide">
        <div
          class="cs__visual-frame reveal"
          style={`--cs-bg: ${d.bg || '#1A1410'}; --cs-acc: ${d.accent || '#B25814'};`}
        >
          <picture>
            <source
              type="image/webp"
              srcset={`${withBase(d.cover.replace(/^\/covers\/(.+)\.jpe?g$/i, '/covers/4k/$1.webp'))} 3840w, ${withBase(d.cover.replace(/\.jpe?g$/i, '.webp'))} 1280w`}
              sizes="(min-width: 1280px) 1200px, 100vw"
            />
            <img
              src={withBase(d.cover)}
              alt={`${d.title} — preview`}
              class="cs__visual-img"
              loading="eager"
              fetchpriority="high"
              width="3840"
              height="2400"
            />
          </picture>
        </div>
      </div>
    </section>
  )}

  <!-- Case sections — each split from markdown, rendered as a full block.
       If a stat is defined, it's injected after the first section. -->
  {sections.map((sec, i) => (
    <>
      <section
        class:list={['cs__section', i % 2 === 1 && 'cs__section--alt']}
        id={`section-${i + 1}`}
      >
        <div class="container cs__section-grid">
          <div class="cs__section-num-col">
            <span class="mono cs__section-num reveal">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="cs__section-content">
            <h2 class="cs__section-h reveal">{sec.heading}</h2>
            <div class="cs__section-body cs__prose reveal" set:html={sec.html} />
          </div>
        </div>
      </section>

      {stat && i === statAfterIndex && (
        <section class="cs__stat" aria-label="Key result">
          <div class="container cs__stat-inner reveal">
            <div class="cs__stat-value">{stat.value}</div>
            <div class="cs__stat-label">{stat.label}</div>
          </div>
        </section>
      )}
    </>
  ))}

  <hr class="divider" />

  <!-- Footer CTA — back to /work, contact -->
  <section class="cs__cta section">
    <div class="container container--narrow cs__cta-inner reveal">
      <a href={p('/work')} class="btn btn--ghost">{t('case.back')}</a>
      <a href={p('/contact')} class="btn btn--primary">{t('method.cta.btn')}</a>
    </div>
  </section>

</article>


<style>
  .cs__back-bar {
    padding-top: var(--sp-md);
    padding-bottom: 0;
  }
  .cs__back {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: color var(--dur-ui) ease;
  }
  .cs__back:hover { color: var(--accent); }

  .cs__hero {
    padding-top: var(--sp-md);
    padding-bottom: var(--sp-lg);
  }
  .cs__hero-inner { max-width: 800px; }
  .cs__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .cs__meta-niche { color: var(--accent); }
  .cs__meta-sep { opacity: 0.5; }
  .cs__meta-tech { color: var(--fg); opacity: 0.75; }
  .cs__meta-result { color: var(--accent); font-weight: 500; }

  .cs__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .cs__tagline {
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }
  .cs__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .cs__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border2);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg);
    white-space: nowrap;
  }
  .cs__chip--link {
    color: var(--accent);
    border-color: var(--accent);
    transition: background var(--dur-ui) ease, color var(--dur-ui) ease;
  }
  .cs__chip--link:hover {
    background: var(--accent);
    color: var(--bg);
  }
  /* ═══ Big visual hero — the case is image-first ═══ */
  .cs__visual {
    padding: var(--sp-md) 0 var(--sp-lg);
  }
  .cs__visual-frame {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--cs-bg);
    border: 1px solid var(--border);
    aspect-ratio: 16 / 10;
    box-shadow: 0 24px 60px rgba(var(--shadow-rgb), 0.12);
  }
  .cs__visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
  }
  @media (max-width: 720px) {
    .cs__visual { padding: var(--sp-sm) 0 var(--sp-md); }
    .cs__visual-frame { border-radius: var(--r-md); }
  }

  /* ═══ Stat callout — big number/fact between sections ═══ */
  .cs__stat {
    padding: var(--sp-xl) 0;
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .cs__stat-inner {
    text-align: center;
    max-width: 900px;
  }
  .cs__stat-value {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(4rem, 12vw, 9rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .cs__stat-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    max-width: 50ch;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ═══ Full-block case sections ═══ */
  .cs__section {
    padding: var(--sp-lg) 0;
    border-top: 1px solid var(--border);
  }
  .cs__section--alt {
    background: var(--bg2);
  }
  .cs__section-grid {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--sp-lg);
    align-items: start;
    width: 100%;
  }
  @media (max-width: 720px) {
    .cs__section {
      min-height: auto;
      padding: var(--sp-lg) 0;
    }
    .cs__section-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
  .cs__section-num-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .cs__section-num {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-family: var(--font-display);
    font-style: italic;
  }
  @media (max-width: 720px) {
    .cs__section-num {
      font-size: 1.75rem;
    }
  }
  .cs__section-content {
    display: flex;
    flex-direction: column;
    max-width: 70ch;
  }
  .cs__section-h {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: var(--fg);
  }
  /* Stagger reveal — number → heading → body */
  .cs__section .reveal {
    transition-delay: 0ms;
  }
  .cs__section .cs__section-h.reveal {
    transition-delay: 80ms;
  }
  .cs__section .cs__section-body.reveal {
    transition-delay: 160ms;
  }

  /* Body prose — markdown renders inside each section body */
  .cs__prose :global(h2) {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .cs__prose :global(h2:first-child) { margin-top: 0; }
  .cs__prose :global(h3) {
    font-size: 1.375rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .cs__prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
    max-width: 65ch;
  }
  /* Magazine-style lede: the first paragraph in each section reads bigger */
  .cs__prose :global(> p:first-of-type) {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--fg);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .cs__prose :global(> p:first-of-type::first-line) {
    font-weight: 500;
  }
  .cs__prose :global(ul),
  .cs__prose :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
    padding: 0;
  }
  .cs__prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .cs__prose :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }
  .cs__prose :global(em) {
    font-style: italic;
    color: var(--accent);
  }
  .cs__prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--card);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: var(--fg);
  }
  .cs__prose :global(pre) {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .cs__prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .cs__prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .cs__prose :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    transition: opacity var(--dur-ui) ease;
  }
  .cs__prose :global(a:hover) { opacity: 0.7; }

  .cs__cta-inner {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
