---
import { useT, localePath } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
import { phases, pickLocale } from '../../data/methodPhases';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const p = (path: string) => localePath(path, lang);
---

<!-- Hero -->
<section class="m-hero">
  <div class="container m-hero__inner reveal">
    <span class="eyebrow">{t('method.eyebrow')}</span>
    <h1 class="m-hero__h1">{t('method.h1')}</h1>
    <p class="m-hero__sub">{t('method.sub')}</p>
    <p class="m-hero__intro">{t('method.intro')}</p>

    <!-- Anchor strip — quick jump to any phase -->
    <nav class="m-anchors" aria-label="Phase navigation">
      {phases.map(ph => (
        <a href={`#phase-${ph.num}`} class="m-anchor mono">
          <span class="m-anchor__num">{ph.num}</span>
          <span class="m-anchor__name">{pickLocale(ph.name, lang)}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<hr class="divider" />

<!-- Phase list — deeper, more breathing room than homepage version -->
<section class="m-phases section--lg">
  <div class="container">
    <ol class="m-list">
      {phases.map((ph) => {
        const what = pickLocale(ph.what, lang);
        const howLines = pickLocale(ph.how, lang).split('\n').filter(Boolean);
        const failLines = pickLocale(ph.failures, lang).split('\n').filter(Boolean);
        return (
          <li class="m-phase reveal" id={`phase-${ph.num}`}>
            <header class="m-phase__head">
              <span class="mono m-phase__num">{ph.num}</span>
              <h2 class="m-phase__name">{pickLocale(ph.name, lang)}</h2>
              <p class="m-phase__what">{what}</p>
            </header>

            {(howLines.length > 0 || failLines.length > 0) && (
              <details class="m-phase__more">
                <summary class="m-phase__more-sum mono">{t('method.more')}</summary>
                <div class="m-phase__cols">
                  {howLines.length > 0 && (
                    <div class="m-block">
                      <span class="mono m-block__label">{t('method.how')}</span>
                      <ul class="m-block__list">
                        {howLines.map((line) => <li>{line}</li>)}
                      </ul>
                    </div>
                  )}
                  {failLines.length > 0 && (
                    <div class="m-block">
                      <span class="mono m-block__label m-block__label--warn">{t('method.failures')}</span>
                      <ul class="m-block__list m-block__list--muted">
                        {failLines.map((line) => <li>{line}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</section>

<hr class="divider" />

<!-- CTA -->
<section class="m-cta section">
  <div class="container container--narrow m-cta__inner reveal">
    <h2 class="m-cta__h2">{t('method.cta.h')}</h2>
    <p class="m-cta__body">{t('method.cta.body')}</p>
    <a href={p('/contact')} class="btn btn--primary btn--lg">{t('method.cta.btn')}</a>
  </div>
</section>


<style>
  .m-hero {
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-lg);
  }
  .m-hero__inner { max-width: 800px; }
  .m-hero__h1 { margin-top: 0.5rem; margin-bottom: 1.5rem; }
  .m-hero__sub {
    font-size: 1.25rem;
    color: var(--fg);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }
  .m-hero__intro {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 65ch;
  }

  .m-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }
  .m-phase {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: var(--sp-md) 0 var(--sp-lg);
    border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .m-phase:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Anchor strip — compact grid of phase links */
  .m-anchors {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    margin-top: var(--sp-md);
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 720px) {
    .m-anchors { grid-template-columns: repeat(2, 1fr); }
  }
  .m-anchor {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--r-sm);
    color: var(--muted);
    transition: background var(--dur-ui) ease, color var(--dur-ui) ease;
    font-size: 0.8125rem;
  }
  .m-anchor:hover {
    background: var(--bg2);
    color: var(--fg);
  }
  .m-anchor__num {
    color: var(--accent);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
  .m-anchor__name {
    font-family: var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .m-phase__head {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .m-phase__num {
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    opacity: 0.85;
  }
  .m-phase__name {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .m-phase__what {
    font-size: 1.125rem;
    color: var(--fg);
    line-height: 1.55;
    max-width: 60ch;
  }

  .m-phase__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 720px) {
    .m-phase__cols { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* Collapsible details — keep phases scannable, depth on demand */
  .m-phase__more { margin-top: 0.25rem; }
  .m-phase__more-sum {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.35rem 0;
    transition: opacity var(--dur-ui) ease;
  }
  .m-phase__more-sum::-webkit-details-marker { display: none; }
  .m-phase__more-sum::after { content: '+'; font-size: 1rem; line-height: 1; }
  .m-phase__more[open] .m-phase__more-sum::after { content: '–'; }
  .m-phase__more-sum:hover { opacity: 0.7; }
  .m-phase__more[open] .m-phase__cols { margin-top: 1rem; }

  .m-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .m-block__label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .m-block__label--warn { color: var(--accent); }
  .m-block__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1rem;
    margin: 0;
  }
  .m-block__list li {
    position: relative;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .m-block__list li::before {
    content: '—';
    position: absolute;
    left: -1rem;
    color: var(--border2);
  }
  .m-block__list--muted li { color: var(--muted); }

  .m-phase__practice {
    margin-top: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg2);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .m-phase__practice-label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .m-phase__practice-note {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    max-width: 70ch;
    margin: 0;
  }
  .m-phase__practice-link {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    transition: opacity var(--dur-ui) ease;
  }
  .m-phase__practice-link:hover { opacity: 0.7; }

  .m-cta__inner {
    text-align: center;
  }
  .m-cta__h2 {
    margin-bottom: 1rem;
  }
  .m-cta__body {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 55ch;
  }
</style>
