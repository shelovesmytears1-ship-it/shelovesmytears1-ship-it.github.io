---
import { useT } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);

const faqs = [
  { q: t('contact.faq.q1'), a: t('contact.faq.a1') },
  { q: t('contact.faq.q2'), a: t('contact.faq.a2') },
  { q: t('contact.faq.q3'), a: t('contact.faq.a3') },
  { q: t('contact.faq.q4'), a: t('contact.faq.a4') },
  { q: t('contact.faq.q5'), a: t('contact.faq.a5') },
  { q: t('contact.faq.q6'), a: t('contact.faq.a6') },
];
---

<!-- Hero -->
<section class="c-hero">
  <div class="container c-hero__inner reveal">
    <span class="eyebrow">{t('contact.eyebrow')}</span>
    <h1 class="c-hero__h1">{t('contact.h1')}</h1>
    <p class="c-hero__sub">{t('contact.sub')}</p>
    <p class="c-hero__response mono">{t('contact.response')}</p>
  </div>
</section>

<hr class="divider" />

<!-- Main grid: form + alt channels -->
<section class="c-main section">
  <div class="container c-main__grid">

    <!-- Brief intake form -->
    <form
      class="c-form reveal"
      name="brief"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="#sent"
    >
      <!-- Hidden inputs required by Netlify Forms -->
      <input type="hidden" name="form-name" value="brief" />
      <p class="c-form__honeypot" hidden aria-hidden="true">
        <label>Bot field <input name="bot-field" /></label>
      </p>

      <div class="c-form__row">
        <label for="f-name" class="c-form__label mono">{t('contact.form.name')}</label>
        <input
          id="f-name"
          name="name"
          type="text"
          required
          class="c-form__input"
          autocomplete="name"
        />
      </div>

      <div class="c-form__row">
        <label for="f-contact" class="c-form__label mono">{t('contact.form.contact')}</label>
        <input
          id="f-contact"
          name="contact"
          type="text"
          required
          class="c-form__input"
          placeholder="@nick / email"
        />
      </div>

      <div class="c-form__row">
        <label for="f-niche" class="c-form__label mono">{t('contact.form.niche')}</label>
        <select id="f-niche" name="niche" class="c-form__input c-form__select">
          <option value="saas">{t('contact.form.niche.saas')}</option>
          <option value="ecom">{t('contact.form.niche.ecom')}</option>
          <option value="services">{t('contact.form.niche.services')}</option>
          <option value="personal">{t('contact.form.niche.personal')}</option>
          <option value="cultural">{t('contact.form.niche.cultural')}</option>
          <option value="multipage">{t('contact.form.niche.multipage')}</option>
          <option value="bot">{t('contact.form.niche.bot')}</option>
          <option value="other">{t('contact.form.niche.other')}</option>
        </select>
      </div>

      <div class="c-form__row">
        <label for="f-link" class="c-form__label mono">{t('contact.form.link')}</label>
        <input
          id="f-link"
          name="link"
          type="url"
          class="c-form__input"
          placeholder="https://"
        />
      </div>

      <div class="c-form__row">
        <label for="f-desc" class="c-form__label mono">{t('contact.form.desc')}</label>
        <textarea
          id="f-desc"
          name="desc"
          rows="5"
          required
          class="c-form__input c-form__textarea"
        ></textarea>
      </div>

      <button type="submit" class="btn btn--primary btn--lg c-form__submit">
        {t('contact.form.submit')}
      </button>

      <p class="c-form__note mono">{t('contact.form.note')}</p>
    </form>

    <!-- Alt channels + FAQ aside -->
    <aside class="c-alt reveal">

      <div class="c-alt__block">
        <span class="mono c-alt__label">{t('contact.alt.title')}</span>
        <a href="https://t.me/zzxvaracaa" target="_blank" rel="noopener" class="c-alt__channel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 5L2 12.5l7 1M21 5l-2.5 15L9 13.5M21 5L9 13.5m0 0v5l3.5-3"/>
          </svg>
          <span>{t('contact.alt.tg')}</span>
        </a>
        <a href="mailto:overflow.web1@gmail.com" class="c-alt__channel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <path d="M22 6l-10 7L2 6"/>
          </svg>
          <span>{t('contact.alt.mail')}</span>
        </a>
        <a href="https://www.instagram.com/overflow.web" target="_blank" rel="noopener" class="c-alt__channel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          <span>{t('contact.alt.ig')}</span>
        </a>
      </div>

      <div class="c-alt__block">
        <span class="mono c-alt__label">{t('contact.faq.title')}</span>
        <div class="c-faq">
          {faqs.map((f) => (
            <details class="c-faq__item">
              <summary class="c-faq__q">
                <span>{f.q}</span>
                <span class="c-faq__plus" aria-hidden="true">+</span>
              </summary>
              <p class="c-faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </aside>

  </div>
</section>


<style>
  .c-hero {
    /* Hero fills the viewport so the form sits below the fold,
       letting the headline land without competition.
       Subtract nav height to avoid scrolling past the hook. */
    min-height: calc(100vh - var(--nav-h));
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-xl);
    display: flex;
    align-items: center;
  }
  .c-hero__inner { max-width: 760px; }
  .c-hero__h1 { margin-top: 0.5rem; margin-bottom: 1.5rem; }
  .c-hero__sub {
    font-size: 1.25rem;
    color: var(--fg);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }
  .c-hero__response {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-block;
  }

  /* Breathing room between hero block and the form grid. */
  .c-main {
    padding-top: var(--sp-2xl);
    padding-bottom: var(--sp-2xl);
  }
  .c-main__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-xl);
    align-items: start;
  }
  @media (max-width: 900px) {
    .c-main__grid { grid-template-columns: 1fr; gap: var(--sp-lg); }
  }

  /* Form */
  .c-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .c-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .c-form__row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .c-form__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .c-form__input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 0.85rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--fg);
    transition: border-color var(--dur-ui) ease, background var(--dur-ui) ease;
    width: 100%;
  }
  .c-form__input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--card);
  }
  .c-form__textarea {
    resize: vertical;
    min-height: 130px;
    font-family: var(--font-body);
    line-height: 1.5;
  }
  .c-form__select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0l5 6 5-6z' fill='%237A6E5C'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
  }
  :global([data-theme="dark"]) .c-form__select {
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0l5 6 5-6z' fill='%239E907C'/%3E%3C/svg%3E");
  }
  .c-form__submit {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
  .c-form__note {
    font-size: 0.6875rem;
    color: var(--muted);
    opacity: 0.75;
    margin-top: 0.5rem;
  }
  /* Alt sidebar */
  .c-alt {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }
  @media (max-width: 900px) {
    .c-alt { position: static; }
  }
  .c-alt__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .c-alt__block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .c-alt__channel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--fg);
    transition: border-color var(--dur-ui) ease, color var(--dur-ui) ease;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .c-alt__channel:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .c-alt__channel svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* FAQ */
  .c-faq {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .c-faq__item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: border-color var(--dur-ui) ease;
  }
  .c-faq__item[open] { border-color: var(--border2); }
  .c-faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .c-faq__q::-webkit-details-marker { display: none; }
  .c-faq__plus {
    color: var(--accent);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform var(--dur-ui) ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }
  .c-faq__item[open] .c-faq__plus {
    transform: rotate(45deg);
  }
  .c-faq__a {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 0 1.1rem 1.1rem;
    margin: 0;
    max-width: none;
  }
</style>
