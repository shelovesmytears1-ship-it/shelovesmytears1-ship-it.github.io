---
import { useT, localePath } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
import JsonLd from '../JsonLd.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const p = (path: string) => localePath(path, lang);
---

<JsonLd type="about" lang={lang} />

<!-- Hero -->
<section class="a-hero">
  <div class="container a-hero__inner reveal">
    <span class="eyebrow">{t('about.eyebrow')}</span>
    <h1 class="a-hero__h1">{t('about.h1')}</h1>
    <p class="a-hero__sub">{t('about.sub')}</p>
  </div>
</section>

<hr class="divider" />

<!-- 3 sections -->
<section class="a-sections section">
  <div class="container">

    <div class="a-section reveal">
      <h2 class="a-section__h">{t('about.s1.h')}</h2>
      <p class="a-section__body">{t('about.s1.body')}</p>
    </div>

    <div class="a-section reveal">
      <h2 class="a-section__h">{t('about.s4.h')}</h2>
      <p class="a-section__body">{t('about.s4.body')}</p>
    </div>

    <div class="a-section reveal">
      <h2 class="a-section__h">{t('about.s5.h')}</h2>
      <ul class="a-section__list">
        <li>{t('about.s5.body.b1')}</li>
        <li>{t('about.s5.body.b2')}</li>
        <li>{t('about.s5.body.b3')}</li>
        <li>{t('about.s5.body.b4')}</li>
      </ul>
    </div>

    <div class="a-section reveal">
      <h2 class="a-section__h">{t('about.s6.h')}</h2>
      <p class="a-section__body">{t('about.s6.body.intro')}</p>
      <dl class="a-stack">
        <div class="a-stack__row">
          <dt class="a-stack__label mono">{t('about.s6.lang.label')}</dt>
          <dd class="a-stack__value">{t('about.s6.lang.value')}</dd>
        </div>
        <div class="a-stack__row">
          <dt class="a-stack__label mono">{t('about.s6.fw.label')}</dt>
          <dd class="a-stack__value">{t('about.s6.fw.value')}</dd>
        </div>
        <div class="a-stack__row">
          <dt class="a-stack__label mono">{t('about.s6.anim.label')}</dt>
          <dd class="a-stack__value">{t('about.s6.anim.value')}</dd>
        </div>
        <div class="a-stack__row">
          <dt class="a-stack__label mono">{t('about.s6.deploy.label')}</dt>
          <dd class="a-stack__value">{t('about.s6.deploy.value')}</dd>
        </div>
      </dl>
      <p class="a-section__body a-section__body--muted">{t('about.s6.outro')}</p>
    </div>

  </div>
</section>

<hr class="divider" />

<!-- CTA -->
<section class="a-cta section">
  <div class="container container--narrow a-cta__inner reveal">
    <a href={p('/contact')} class="btn btn--primary btn--lg">{t('about.cta')}</a>
  </div>
</section>


<style>
  .a-hero {
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-lg);
  }
  .a-hero__inner { max-width: 760px; }
  .a-hero__h1 { margin-top: 0.5rem; margin-bottom: 1.25rem; }
  .a-hero__sub {
    font-size: 1.25rem;
    color: var(--muted);
    line-height: 1.55;
    max-width: 60ch;
  }

  .a-sections {
    max-width: 760px;
    margin: 0 auto;
  }
  .a-section {
    padding: var(--sp-lg) 0;
    border-bottom: 1px solid var(--border);
  }
  .a-section:first-child { padding-top: 0; }
  .a-section:last-child { border-bottom: none; padding-bottom: 0; }
  .a-section__h {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .a-section__body {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 65ch;
  }
  .a-section__body:last-child { margin-bottom: 0; }
  .a-section__body--muted { color: var(--muted); }
  .a-section__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .a-section__list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 65ch;
  }
  .a-section__list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 500;
  }

  .a-cta__inner {
    text-align: center;
  }

  /* ─── Stack table ─── */
  .a-stack {
    margin: 1.5rem 0 1.25rem;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .a-stack__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  @media (max-width: 600px) {
    .a-stack__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.75rem 0;
    }
  }
  .a-stack__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .a-stack__value {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg);
  }
</style>
