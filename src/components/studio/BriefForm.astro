    recipient: 'Recipient: Overflow Web — Daniil',
    titlePay: 'Transfer title: Website setup deposit — ',
    blik: 'BLIK to number: +48 501 391 291 (or bank transfer)',
    waBtn: 'Open WhatsApp to confirm start →',
    waIntro: 'Hi Daniil! I filled in the project brief on Overflow Web.',
  },
  ua: {
    metaGhost: 'СТАРТ',
    eye: 'ФОРМА ЗАПУСКУ ПРОЄКТУ',
    title: 'Запуск сайту',
    titleAccent: 'One-Page.',
    lede: 'Заповніть дані нижче (займає близько 3 хвилин). На їх основі ми створюємо структуру сайту, підключаємо домен та запускаємо проєкт за 4–5 днів.',
