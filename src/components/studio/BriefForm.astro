const t = dict[lang] || dict.pl;
---

<section class="page-hero wrap">
  <span class="pg-ghost" aria-hidden="true">{t.metaGhost}</span>
  <p class="eye">{t.eye}</p>
  <h1 class="disp contact-title">{t.title} <em>{t.titleAccent}</em></h1>
  <p class="page-lede">{t.lede}</p>
</section>

<section class="sec wrap" style="max-width: 860px; margin-inline: auto;">
  <div class="brief-card">
    <form id="brief-form" class="brief-form" data-intro={t.waIntro} data-lang={lang}>
      <!-- Sekcja 1: Dane firmy -->
      <div class="brief-group">
        <h2 class="brief-heading"><span>01</span> {t.sec1}</h2>
        <label class="b-field">
          <span>{t.name}</span>
          <input type="text" id="b-name" name="name" required placeholder={t.namePh} />
        </label>
        <div class="b-row">
          <label class="b-field">
            <span>{t.phone}</span>
            <input type="tel" id="b-phone" name="phone" required placeholder={t.phonePh} />
          </label>
          <label class="b-field">
            <span>{t.email}</span>
            <input type="email" id="b-email" name="email" required placeholder={t.emailPh} />
          </label>
        </div>
        <label class="b-field">
          <span>{t.city}</span>
          <input type="text" id="b-city" name="city" required placeholder={t.cityPh} />
        </label>
      </div>

      <!-- Sekcja 2: Oferta i usługi -->
      <div class="brief-group">
        <h2 class="brief-heading"><span>02</span> {t.sec2}</h2>
        <label class="b-field">
          <span>{t.services}</span>
          <textarea id="b-services" name="services" rows="4" required placeholder={t.servicesPh}></textarea>
        </label>
        <label class="b-field">
          <span>{t.certs}</span>
          <input type="text" id="b-certs" name="certs" placeholder={t.certsPh} />
        </label>
        <label class="b-field">
          <span>{t.domain}</span>
          <input type="text" id="b-domain" name="domain" placeholder={t.domainPh} />
        </label>
        <label class="b-field">
          <span>{t.photos}</span>
          <input type="url" id="b-photos" name="photos" placeholder={t.photosPh} />
          <small class="b-hint">{t.photosHint}</small>
        </label>
      </div>

      <!-- Sekcja 3: Warunki umowy -->
      <div class="brief-group">
        <h2 class="brief-heading"><span>03</span> {t.sec3}</h2>
        <div class="terms-box">
          <h3 class="terms-title">{t.termsTitle}</h3>
          <ul class="terms-list">
            <li><strong>{t.termsPrice}</strong></li>
            <li><strong>{t.termsDeposit}</strong></li>
            <li>{t.termsTime}</li>
            <li>{t.termsQuality}</li>
          </ul>
        </div>

        <label class="b-checkbox">
          <input type="checkbox" id="b-terms" name="terms" required />
          <span><strong>{t.checkbox}</strong></span>
        </label>
      </div>

      <button type="submit" class="btn magnetic b-submit" data-cursor>
        <span class="btn-text">{t.submit}</span>
      </button>
    </form>

    <!-- Ekran sukcesu -->
    <div id="brief-success" class="brief-success" hidden>
      <div class="success-icon">✓</div>
      <h2 class="disp">{t.successTitle}</h2>
      <p class="success-lead">{t.successLead}</p>
      
      <div class="success-box">
        <h3>{t.stepTitle}</h3>
        <p>{t.stepDesc}</p>
        <div class="pay-details">
          <p><strong>{t.recipient}</strong></p>
          <p><strong>{t.titlePay}</strong><span id="pay-name">[Nazwa]</span></p>
          <p><strong>{t.blik}</strong></p>
        </div>
      </div>

      <a id="wa-confirm-btn" href="#" target="_blank" rel="noopener" class="btn magnetic" style="margin-top: 2rem;">
        <span class="btn-text">{t.waBtn}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .brief-card {
    background: var(--surface, color-mix(in srgb, var(--ink) 4%, transparent));
    border: 1px solid var(--line, rgba(0, 0, 0, 0.1));
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .brief-group {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line, rgba(0, 0, 0, 0.08));
  }
  .brief-group:last-of-type {
    border-bottom: none;
    margin-bottom: 1.5rem;
  }
  .brief-heading {
    font-family: var(--disp), sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brief-heading span {
    font-family: var(--mono), monospace;
    font-size: 0.85rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }
  .b-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .b-field span {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
  }
  .b-field input, .b-field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line, rgba(0,0,0,0.15));
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .b-field input:focus, .b-field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .b-hint {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .b-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 600px) {
    .b-row { grid-template-columns: 1fr; }
  }
  .terms-box {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 10px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .terms-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .terms-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .terms-list li::before {
    content: "✓ ";
    color: var(--accent);
    font-weight: bold;
  }
  .b-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.92rem;
    line-height: 1.45;
    user-select: none;
  }
  .b-checkbox input {
    margin-top: 0.2rem;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }
  .b-submit {
    --fd: 2800px !important;
    width: 100%;
    padding: 1.1rem;
    font-size: 1.05rem;
    text-align: center;
    justify-content: center;
  }
  .brief-success {
    text-align: center;
    padding: 2rem 1rem;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    background: var(--accent);
    color: #fff;
    font-size: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 1.5rem;
  }
  .success-lead {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .success-box {
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
    border: 1px dashed var(--accent);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: left;
    max-width: 500px;
    margin: 0 auto;
  }
  .success-box h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .pay-details {
    margin-top: 1rem;
    font-family: var(--mono), monospace;
    font-size: 0.88rem;
    line-height: 1.8;
    background: var(--bg);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
</style>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement;
  const success = document.getElementById('brief-success');
  const payName = document.getElementById('pay-name');
  const waBtn = document.getElementById('wa-confirm-btn') as HTMLAnchorElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = fd.get('name') as string;
    const phone = fd.get('phone') as string;
    const email = fd.get('email') as string;
    const city = fd.get('city') as string;
    const services = fd.get('services') as string;
    const certs = fd.get('certs') as string;
    const domain = fd.get('domain') as string;
    const photos = fd.get('photos') as string;
    const waIntro = form.dataset.intro || 'Cześć Daniil!';
    const curLang = form.dataset.lang || 'pl';

    // Send submission directly to Telegram Bot (@qweqweqweqqq_bot)
    try {
      const tgText = `🔥 <b>NOWE ZGŁOSZENIE / BRIEF (1 490 zł) [${curLang.toUpperCase()}]</b>\n\n` +
        `👤 <b>Klient / Firma:</b> ${name}\n` +
        `📞 <b>Telefon:</b> ${phone}\n` +
        `✉️ <b>E-mail:</b> ${email}\n` +
        `📍 <b>Miasto:</b> ${city}\n\n` +
        `🛠 <b>Usługi i cennik:</b>\n${services}\n\n` +
        (certs ? `📜 <b>Certyfikaty:</b> ${certs}\n` : '') +
        (domain ? `🌐 <b>Domena:</b> ${domain}\n` : '') +
        (photos ? `📸 <b>Zdjęcia/Logo:</b> ${photos}\n` : '') +
        `\n✅ <b>Warunki umowy 50/50:</b> Zaakceptowano (1 490 zł, zadatek 745 zł)`;

      fetch('https://api.telegram.org/bot9268064724:AAFb0yXWLH2DmssGfsCbW_bibew0NoJ_Lws/sendMessage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          chat_id: '1327146718',
          text: tgText,
          parse_mode: 'HTML',
        }),
      }).catch(() => {});
    } catch {}

    // Update success screen
    if (payName) payName.textContent = name;

    // Format WhatsApp message
    const msg = `${waIntro}\n\n` +
      `*Firma / Klient:* ${name}\n` +
      `*Telefon:* ${phone}\n` +
      `*E-mail:* ${email}\n` +
      `*Miasto:* ${city}\n` +
      `*Usługi:* ${services}\n` +
      (certs ? `*Uprawnienia:* ${certs}\n` : '') +
      (domain ? `*Domena:* ${domain}\n` : '') +
      (photos ? `*Zdjęcia/Logo:* ${photos}\n` : '') +
      `\n*Akceptuję warunki umowy (1 490 zł, 50% zadatku na start).* Czekam na potwierdzenie startu!`;

    if (waBtn) {
      waBtn.href = `https://wa.me/48501391291?text=${encodeURIComponent(msg)}`;
    }

    form.style.display = 'none';
    if (success) success.hidden = false;
    window.scrollTo({ top: 100, behavior: 'smooth' });
  });
</script>
