---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { getNewDirectionCopy } from '../../data/newDirectionI18n';
import { getTagline, getSummary, getBody, getResult, getStat } from '../../data/caseHelpers';
import { withBase } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang; entry: CollectionEntry<'cases'> }
const { lang = 'pl', entry } = Astro.props;
const c = getNewDirectionCopy(lang);
const d = entry.data;
const p = (slug: string) => (lang === 'pl' ? `/${slug}/` : `/${lang}/${slug}/`);

type Section = { heading: string; html: string };
function parseSections(body: string): Section[] {
  const parts = body.split(/^## /m).map((s) => s.trim()).filter(Boolean);
  return parts.map((part) => {
    const nl = part.indexOf('\n');
    const heading = nl === -1 ? part : part.slice(0, nl).trim();
    const md = nl === -1 ? '' : part.slice(nl + 1).trim();
    return { heading, html: marked.parse(md, { async: false }) as string };
  });
}
// meta-grid column labels (values come from the entry's own frontmatter)
const metaLabels: Record<string, { stack: string; niche: string; where: string }> = {
  pl: { stack: 'Stack', niche: 'Branża', where: 'Rok i region' },
  ru: { stack: 'Стек', niche: 'Ниша', where: 'Год и регион' },
  en: { stack: 'Stack', niche: 'Industry', where: 'Year & region' },
  ua: { stack: 'Стек', niche: 'Ніша', where: 'Рік і регіон' },
};
const ml = metaLabels[lang] ?? metaLabels.en;

const sections = parseSections(getBody(entry, lang));
const stat = getStat(entry, lang);
const result = getResult(entry, lang);

// next project (by order, wrap around)
const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((x) => x.slug === entry.slug);
const next = all[(idx + 1) % all.length];
---

<article class="cs">
  <div class="wrap cs-back"><a href={p('work')} class="link" data-cursor>← {c.case.allWork}</a></div>

  <header class="wrap cs-hero">
    <p class="eye" data-reveal>{d.niche} · {d.year}{d.region[0] ? ` · ${d.region.join(' · ')}` : ''}</p>
    <h1 class="disp" data-reveal>{d.title}</h1>
    <p class="cs-tagline" data-reveal>{getSummary(entry, lang)}</p>
    <div class="cs-chips" data-reveal>
      {result && <span class="cs-chip cs-chip--accent">→ {result}</span>}
      {d.siteUrl && <a class="cs-chip cs-chip--link" href={d.siteUrl} target="_blank" rel="noopener" data-cursor>{c.case.openSite} ↗</a>}
    </div>
  </header>

  <!-- meta grid: three short columns instead of a prose lead-in -->
  <div class="wrap cs-meta" data-reveal>
    <div class="cs-meta-col">
      <h2 class="cs-meta-label">{ml.stack}</h2>
      <div class="cs-stripe"></div>
      <ul>{d.technologies.map((t) => (<li>{t}</li>))}</ul>
    </div>
    <div class="cs-meta-col">
      <h2 class="cs-meta-label">{ml.niche}</h2>
      <div class="cs-stripe"></div>
      <ul><li>{d.niche}</li></ul>
    </div>
    <div class="cs-meta-col">
      <h2 class="cs-meta-label">{ml.where}</h2>
      <div class="cs-stripe"></div>
      <ul>
        <li>{d.year}</li>
        {d.region.map((r) => (<li>{r}</li>))}
      </ul>
    </div>
  </div>

  {d.cover && (
    <div class="wrap cs-cover-wrap" data-reveal>
      <div class="cs-device">
        <div class="cs-device-screen">
          <div class="cs-device-media">
            <!-- background layer, 120% tall at top:-10% — the extra height can only
                 be spent on vertical crop, never on width (an <img> with object-fit
                 would trade it for width and slice the sides) -->
            <div
              class="cs-device-inner"
              data-speed="1.2"
              role="img"
              aria-label={`${d.title} — ${c.case.coverAlt}`}
              style={`background-image:url('${withBase(d.cover)}');background-color:${d.bg || '#c9c4bb'}`}
            ></div>
          </div>
        </div>
        <div class="cs-device-base" aria-hidden="true"></div>
      </div>
    </div>
  )}

  {sections.map((sec, i) => (
    <section class="wrap cs-sec">
      <span class="cs-num disp">{String(i + 1).padStart(2, '0')}</span>
      <div class="cs-sec-body">
        <h2 class="disp" data-reveal>{sec.heading}</h2>
        <div class="cs-prose" data-reveal set:html={sec.html} />
        {stat && i === 0 && (
          <div class="cs-stat" data-reveal>
            <div class="cs-stat-val disp">{stat.value}</div>
            <div class="cs-stat-label">{stat.label}</div>
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="cs-next">
    <div class="cs-next-arc" data-collapse="9" aria-hidden="true"><span></span></div>
    <div class="cs-next-inner" data-speed="-1.4">
      <p class="cs-next-eye">{c.case.nextAction}</p>
      <a href={p(`work/${next.slug}`)} class="cs-next-link" data-cursor data-tname={next.data.title}>
        <h2 class="cs-next-title disp">{next.data.title}</h2>
        <div class="cs-next-window" data-speed="1.9">
          <div class="cs-next-img" style={`background-image:url('${withBase(next.data.cover || '')}')`}></div>
        </div>
      </a>
      <div class="cs-next-actions">
        <a href={p('work')} class="btn btn-ghost cs-next-btn" data-cursor>{c.case.allWork} ↗</a>
        <a href={p('contact')} class="btn magnetic" data-cursor>{c.method.ctaButton} →</a>
      </div>
    </div>
  </section>
</article>

<style>
  .cs-back{padding-top:6.5rem;}
  .cs-hero{padding:2rem 0 2.5rem;max-width:900px;}
  .cs-hero h1{font-size:clamp(2.6rem,7vw,6rem);margin:.8rem 0 1.2rem;}
  .cs-tagline{color:var(--muted);font-size:clamp(1.05rem,1.6vw,1.3rem);max-width:52ch;}
  .cs-chips{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.6rem;}
  .cs-chip{font-family:var(--mono),monospace;font-size:.72rem;letter-spacing:.04em;padding:.4rem .8rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);}
  .cs-chip--accent{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 40%,var(--line));}
  .cs-chip--link{color:var(--accent);border-color:var(--accent);}
  .cs-chip--link:hover{background:var(--accent);color:var(--on-accent);}
  /* ---- meta grid ---- */
  .cs-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,4vw,3rem);margin:2.5rem auto 3.5rem;}
  .cs-meta-label{font-family:var(--mono),monospace;font-weight:400;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);}
  .cs-stripe{height:1px;background:var(--line);margin:1.1rem 0 1rem;}
  .cs-meta ul{list-style:none;}
  .cs-meta li{font-size:.95rem;line-height:1.8;}
  @media(max-width:720px){.cs-meta{grid-template-columns:1fr;gap:1.4rem;margin-bottom:2.5rem;}}

  /* ---- laptop mockup ---- */
  .cs-cover-wrap{margin:0 auto 4.5rem;}
  .cs-device{width:100%;max-width:1060px;margin-inline:auto;}
  .cs-device-screen{background:var(--ink);border-radius:16px;padding:11px;box-shadow:0 44px 100px rgba(20,20,26,.24);}
  .cs-device-media{position:relative;overflow:hidden;border-radius:7px;background:var(--bg);}
  .cs-device-media::before{content:'';display:block;padding-top:62.5%;} /* 16:10 */
  .cs-device-inner{position:absolute;left:0;top:-10%;width:100%;height:120%;
    background-size:cover;background-position:center;will-change:transform;}
  /* hinge + base */
  .cs-device-base{position:relative;width:107%;height:13px;margin:0 -3.5%;
    background:linear-gradient(180deg,#d2cfc8,#a8a49e);border-radius:0 0 11px 11px;}
  .cs-device-base::after{content:'';position:absolute;left:50%;top:0;transform:translateX(-50%);
    width:13%;height:5px;background:rgba(20,20,26,.22);border-radius:0 0 6px 6px;}
  @media(max-width:720px){.cs-device-screen{padding:6px;border-radius:10px;}.cs-device-base{height:9px;}}
  .cs-sec{display:grid;grid-template-columns:7rem 1fr;gap:clamp(1rem,4vw,3rem);padding:clamp(2.5rem,5vw,4rem) 0;border-top:1px solid var(--line);align-items:start;}
  .cs-num{font-size:clamp(2rem,4vw,3.2rem);color:var(--accent);}
  .cs-sec-body{max-width:68ch;}
  .cs-sec-body h2{font-size:clamp(1.6rem,3.4vw,2.6rem);margin-bottom:1.4rem;}
  .cs-prose :global(p){font-size:1.05rem;line-height:1.75;margin-bottom:1.2rem;}
  .cs-prose :global(p:first-of-type){font-size:1.2rem;color:var(--ink);}
  .cs-prose :global(strong){font-weight:700;}
  .cs-prose :global(em){font-family:inherit;font-style:italic;color:var(--accent);}
  .cs-prose :global(ul),.cs-prose :global(ol){margin:0 0 1.2rem 1.3rem;}
  .cs-prose :global(li){margin-bottom:.4rem;line-height:1.6;}
  .cs-stat{margin:2.5rem 0 .5rem;padding:2rem;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--accent) 5%,var(--bg));}
  .cs-stat-val{font-size:clamp(3rem,9vw,6rem);color:var(--accent);line-height:.9;}
  .cs-stat-label{font-family:var(--mono),monospace;font-size:.8rem;letter-spacing:.08em;color:var(--muted);margin-top:.8rem;max-width:46ch;line-height:1.5;}
  /* ---- next case ---- */
  .cs-next{position:relative;margin-top:clamp(4rem,10vh,7rem);background:var(--ink);overflow:hidden;padding-bottom:clamp(3rem,7vh,5rem);}
  /* the seam: a very wide, very tall ellipse in paper colour, pushed up so only
     the bottom of its curve shows through a short window — a shallow arc whose
     curvature does not swing with viewport width */
  .cs-next-arc{position:absolute;top:0;left:0;width:100%;height:9vh;overflow:hidden;z-index:2;pointer-events:none;}
  .cs-next-arc span{position:absolute;left:50%;display:block;width:150%;height:750%;border-radius:50%;background:var(--bg);transform:translate(-50%,-86.666%);}
  .cs-next-inner{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:clamp(6rem,17vh,11rem);}
  .cs-next-eye{font-family:var(--mono),monospace;font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:color-mix(in srgb,var(--bg) 45%,transparent);}
  .cs-next-link{display:block;width:100%;}
  .cs-next-title{font-size:clamp(2.8rem,10vw,8rem);color:var(--bg);margin:.5rem 0 0;transition:opacity .5s cubic-bezier(.7,0,.3,1);}
  /* short window, taller image sitting low inside it — on hover the cover rises
     to fill the frame while the title steps back */
  .cs-next-window{position:relative;width:clamp(11rem,27vw,24rem);margin:1.6rem auto 0;overflow:hidden;}
  .cs-next-window::before{content:'';display:block;padding-bottom:50%;}
  .cs-next-img{position:absolute;top:0;left:0;width:100%;padding-bottom:62.5%;background-size:cover;background-position:center top;transform:translateY(28%);transition:transform .5s cubic-bezier(.7,0,.3,1);}
  .cs-next-link:hover .cs-next-title{opacity:.25;}
  .cs-next-link:hover .cs-next-img{transform:translateY(0);}
  .cs-next-actions{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:clamp(2rem,5vh,3.2rem);}
  /* on the dark panel the fill has to invert the other way */
  .cs-next-btn{color:var(--bg);border-color:color-mix(in srgb,var(--bg) 28%,transparent);}
  .cs-next-btn::before{background:var(--bg);}
  .cs-next-btn:hover{color:var(--ink);}
  @media(max-width:720px){.cs-next-arc{height:5vh;}}
  @media(max-width:720px){.cs-sec{grid-template-columns:1fr;gap:.6rem;}.cs-num{font-size:1.6rem;}}
</style>
