---
import { getCollection } from 'astro:content';
import { getNewDirectionCopy } from '../../data/newDirectionI18n';
import { withBase } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang; variant?: 'studio' | 'editorial' | 'dark' }
const { lang = 'pl', variant = 'studio' } = Astro.props;
const c = getNewDirectionCopy(lang);

const segment = variant === 'studio' ? '' : `/${variant}`;
const root = lang === 'pl' ? segment : `/${lang}${segment}`;
const p = (slug: string) => `${root}/${slug}/`;

const conceptLabel: Record<string, string> = { pl: 'Koncept', ru: 'Концепт', en: 'Concept', ua: 'Концепт' };
const concept = conceptLabel[lang] ?? 'Concept';

const allCases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const pickCases = (slugs: string[]) =>
  slugs.map((slug) => allCases.find((entry) => entry.slug === slug)).filter(Boolean) as typeof allCases;

// Four different commercial categories and four clearly distinct art directions:
// product SaaS, cultural experience, premium service and e-commerce.
const featuredSlugs = ['wavemetrics', 'interspace', 'lunea', 'dzherelo'];
const cases = pickCases(featuredSlugs);

// Featured set for the 3D coverflow carousel
const galleryItems = pickCases([...featuredSlugs, 'prezfull', 'dispersia']).map((project) => ({
  cover: withBase(project.data.cover || ''),
  href:  p(`work/${project.slug}`),
  title: project.data.title,
  niche: project.data.niche || '',
}));

const viewLabel: Record<string, string> = { pl: 'Zobacz', ru: 'Смотреть', en: 'View', ua: 'Дивитись' };
const view = viewLabel[lang] ?? 'View';

// hero footer strip — column labels (the values themselves already live in i18n)
const heroMetaLabels: Record<string, { services: string; location: string }> = {
  pl: { services: 'Usługi', location: 'Lokalizacja' },
  ru: { services: 'Услуги', location: 'Локация' },
  en: { services: 'Services', location: 'Location' },
  ua: { services: 'Послуги', location: 'Локація' },
};
const hm = heroMetaLabels[lang] ?? heroMetaLabels.en;

type W = { w: string; a: boolean };
const heroWords: W[] = [
  ...c.home.heroTitle.split(' ').map((w) => ({ w, a: false })),
  ...c.home.heroAccent.split(' ').map((w) => ({ w, a: true })),
  ...c.home.heroTail.split(' ').map((w) => ({ w, a: false })),
];

// scroll-highlight "verbs" — what I do, end to end (one person, whole project).
// Rendered as a sticky column that ignites in the accent as each word crosses a
// fixed mid-viewport band. Desktop/tablet only — hidden on phones in CSS.
const verbsByLang: Record<string, string[]> = {
  pl: ['projektuję.', 'buduję.', 'wdrażam.', 'optymalizuję.', 'utrzymuję.'],
  ru: ['проектирую.', 'собираю.', 'запускаю.', 'оптимизирую.', 'поддерживаю.'],
  en: ['design.', 'build.', 'ship.', 'optimise.', 'maintain.'],
  ua: ['проєктую.', 'збираю.', 'запускаю.', 'оптимізую.', 'підтримую.'],
};
const verbs = verbsByLang[lang] ?? verbsByLang.en;
const verbsSrByLang: Record<string, string> = {
  pl: 'Projektuję, buduję, wdrażam, optymalizuję i utrzymuję.',
  ru: 'Проектирую, собираю, запускаю, оптимизирую и поддерживаю.',
  en: 'I design, build, ship, optimise and maintain.',
  ua: 'Проєктую, збираю, запускаю, оптимізую і підтримую.',
};
const verbsSrText = verbsSrByLang[lang] ?? verbsSrByLang.en;
---

<!-- HERO — full-bleed section, 3D fills entire viewport -->
<section class="hero">
  <div class="hero-3d" id="hero3d" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-lead">
    <p class="eye">{c.home.meta} · {c.home.location}</p>
    <h1>
      {heroWords.map((it, i) => (
        <>
          <span class="word"><span class={it.a ? 'accent' : ''} style={`transition-delay:${0.045 * i}s`}>{it.w}</span></span>{' '}
        </>
      ))}
    </h1>
    <p class="hero-sub" data-reveal>{c.home.heroBody}</p>
    <div class="hero-actions" data-reveal>
      <a class="btn magnetic" href="#contact" data-cursor><span class="btn-text">{c.home.heroCta} →&#xFE0E;</span></a>
      <a class="btn btn-ghost" href="#work" data-cursor><span class="btn-text">{c.home.allWork}</span></a>
    </div>
    </div>
    <div class="hero-foot">
      <div class="hero-scroll"><span class="dotline"></span> {c.home.introMeta}</div>
      <div class="hero-meta">
        <div class="hero-meta-col">
          <h3 class="hero-meta-label">{hm.services}</h3>
          <ul>{c.home.facts.map((f) => (<li>{f}</li>))}</ul>
        </div>
        <div class="hero-meta-col">
          <h3 class="hero-meta-label">{c.about.stackMeta}</h3>
          <ul>{c.about.stack.slice(0, 3).map((s) => (<li>{s.value}</li>))}</ul>
        </div>
        <div class="hero-meta-col">
          <h3 class="hero-meta-label">{hm.location}</h3>
          <ul>
            <li>{c.home.location}</li>
            <li data-clock data-label="">—</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SCROLL-HIGHLIGHT VERBS — the column rises as you scroll; each word ignites in
     the accent crossing a mid-viewport band, then dissolves behind the Work
     heading that slides in on top. JS-driven (studio.ts); desktop/tablet only. -->
<section class="verbs-stage" style={`--count:${verbs.length}`}>
  <h2 class="verbs-sr">{verbsSrText}</h2>
  <div class="verbs" aria-hidden="true">
    <ul class="verbs-list">
      {verbs.map((w) => (<li>{w}</li>))}
    </ul>
  </div>
  <div class="verbs-head" aria-hidden="true">
    <div class="wrap">
      <h2>{c.home.workTitle}<br /><em>{c.home.workAccent}</em></h2>
    </div>
  </div>
</section>

<!-- WORK -->
<section id="work" class="sec wrap">
  <div class="sec-head">
    <h2 data-reveal>{c.home.workTitle}<br /><em>{c.home.workAccent}</em></h2>
    <a class="link" href={p('work')} data-cursor data-reveal>{c.home.allWork} ↗&#xFE0E;</a>
  </div>

  <div id="gallery3d" class="gallery3d" data-items={JSON.stringify(galleryItems)} aria-hidden="true">
    <div class="gallery3d-title" id="gallery3d-title"></div>
  </div>
  <p class="gallery3d-cap" id="gallery3d-cap" aria-hidden="true"></p>

  <div class="gallery-mobile" role="region" aria-label={c.home.workTitle}>
    {galleryItems.map((project, i) => (
      <a
        class="gallery-mobile-card"
        href={project.href}
        aria-label={`${project.title}, ${i + 1} / ${galleryItems.length}`}
      >
        <span class="project-frame-chrome" aria-hidden="true">
          <span class="project-frame-dots"><i></i><i></i><i></i></span>
          <span class="project-frame-id">{String(i + 1).padStart(2, '0')} / {String(galleryItems.length).padStart(2, '0')}</span>
        </span>
        <span class="project-frame-viewport">
          <img src={project.cover} alt="" width="1280" height="800" loading="lazy" decoding="async" />
        </span>
        <span class="project-frame-caption">
          <strong>{project.title}</strong>
          <small>{project.niche}</small>
        </span>
      </a>
    ))}
  </div>

  <div class="work-list">
    {cases.map((project, i) => (
      <a
        class="work-row"
        href={p(`work/${project.slug}`)}
        data-cursor
        data-reveal
        data-view={view}
        data-preview={withBase(project.data.cover || '')}
      >
        <span class="work-row-thumb" aria-hidden="true">
          <span class="work-row-thumb-bar"><i></i><i></i><i></i></span>
          <img src={withBase(project.data.cover || '')} alt="" width="1280" height="800" loading="lazy" decoding="async" />
        </span>
        <span class="work-no">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <div class="work-name">{project.data.title}</div>
          <div class="work-meta">{project.data.niche} · {project.data.year}</div>
        </div>
        <span class="work-tag">{concept} ↗&#xFE0E;</span>
      </a>
    ))}
  </div>
</section>

<!-- APPROACH -->
<section id="approach" class="sec wrap">
  <div class="sec-head"><h2 data-reveal>{c.home.processTitle}<br /><em>{c.home.processAccent}</em></h2></div>
  <div class="steps" data-reveal>
    {c.home.steps.map((s, i) => (
      <div class="step">
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="sec wrap">
  <div class="about">
    <p class="lead" data-reveal>{c.home.aboutBody}</p>
    <div class="about-side" data-reveal>
      <b>overflow / Daniil</b><br />Gdańsk, PL · Remote<br />—<br />
      {c.about.stack.map((s) => (<>{s.value}<br /></>))}
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="sec wrap contact">
  <p class="eye" data-reveal>{c.home.contactMeta}</p>
  <h2 data-reveal style="margin-top:1rem">{c.home.contactTitle} <em>{c.home.contactAccent}</em></h2>
  <p class="contact-sub" data-reveal>{c.home.contactBody}</p>
  <div class="contact-row" data-reveal>
    <a class="btn magnetic" href="https://t.me/zzxvaracaa" target="_blank" rel="noopener" data-cursor><span class="btn-text">{c.home.contactCta} →&#xFE0E;</span></a>
    <a href="mailto:overflow.web1@gmail.com" data-cursor>overflow.web1@gmail.com</a>
  </div>
</section>
