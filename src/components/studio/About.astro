---
import { getNewDirectionCopy } from '../../data/newDirectionI18n';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;
const c = getNewDirectionCopy(lang);
const p = (slug: string) => (lang === 'pl' ? `/${slug}/` : `/${lang}/${slug}/`);
---

<section class="page-hero wrap">
  <p class="eye" data-reveal>{c.home.aboutMeta}</p>
  <h1 class="disp about-title" data-reveal>{c.about.essayTitle} <em>{c.about.essayAccent}</em></h1>
  <p class="page-lede" data-reveal>{c.about.lede}</p>
</section>

<section class="sec wrap about-grid">
  <div class="about-essay">
    {c.about.paragraphs.map((par) => (<p data-reveal>{par}</p>))}
    <a class="btn magnetic" href={p('contact')} data-cursor data-reveal>{c.about.cta} →</a>
  </div>
  <aside class="about-stack" data-reveal>
    <p class="eye">{c.about.stackMeta}</p>
    <ul>
      {c.about.stack.map((s) => (
        <li><span class="stack-k">{s.label}</span><span class="stack-v">{s.value}</span></li>
      ))}
    </ul>
  </aside>
</section>

<style>
  .about-title{white-space:pre-line;}
  .about-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:clamp(2rem,6vw,5rem);align-items:start;}
  .about-essay p{font-size:1.15rem;line-height:1.75;color:var(--muted);margin-bottom:1.4rem;max-width:58ch;}
  .about-essay p:first-child{color:var(--ink);font-size:1.3rem;}
  .about-stack{border-top:2px solid var(--accent);padding-top:1.2rem;}
  .about-stack ul{list-style:none;margin-top:1rem;}
  .about-stack li{display:flex;flex-direction:column;gap:.15rem;padding:.7rem 0;border-bottom:1px solid var(--line);}
  .stack-k{font-family:var(--mono),monospace;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
  .stack-v{font-size:.95rem;}
  @media(max-width:760px){.about-grid{grid-template-columns:1fr;}}
</style>
