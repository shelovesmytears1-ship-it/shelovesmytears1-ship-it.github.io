---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { useT, getAllLocales, withBase, localePath, defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  title:        string;
  description?: string;
  ogImage?:     string;
  lang:         Lang;
}

const {
  title,
  description = 'Frontend-разработка для бизнеса. Лендинги, multipage, небольшие интернет-магазины. — overflow',
  ogImage     = '/og-default.jpg',
  lang,
} = Astro.props;

const t = useT(lang);
const fullTitle = title.toLowerCase().includes('overflow')
  ? title
  : `${title} — overflow`;

const pathname = Astro.url.pathname;
const alternates = getAllLocales(lang, pathname);
const canonical = new URL(pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang={lang === 'ua' ? 'uk' : lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#FAFAF6" />

  <!-- Pre-paint theme application — prevents flash of wrong theme.
       Must be inline + before stylesheet so it runs synchronously. -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#1A1B1E' : '#FAFAF6');
      } catch (e) { /* SSG fallback: light */ }
    })();
  </script>

  <!-- Page-transition curtain initial style — applied before paint so the
       curtain covers the screen on every load and we never see FOUC. -->
  <style is:global>
    /* Curtain starts covering the screen — GSAP slides it off upward on page enter */
    .page-curtain {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 9999;
      background: var(--accent, #B25814);
      pointer-events: none;
      will-change: transform;
      /* Wave-shaped bottom edge via clip-path for a liquid feel.
         -webkit- prefix covers Safari ≤ 14. */
      -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% 95%, 50% 100%, 0% 95%);
      clip-path: polygon(0% 0%, 100% 0%, 100% 95%, 50% 100%, 0% 95%);
    }
  </style>

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.lang === 'ua' ? 'uk' : alt.lang} href={new URL(alt.href, Astro.site).toString()} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(localePath('/', defaultLang), Astro.site).toString()} />

  <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
  <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16.png')} />
  <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />

  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(withBase(ogImage), Astro.site).toString()} />
  <meta property="og:image:type"  content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="overflow — Frontend development for business" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="overflow" />
  <meta property="og:locale"      content={lang === 'pl' ? 'pl_PL' : lang === 'ru' ? 'ru_RU' : lang === 'ua' ? 'uk_UA' : 'en_US'} />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"      content={new URL(withBase(ogImage), Astro.site).toString()} />
  <meta name="twitter:image:alt"  content="overflow — Frontend development for business" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <JsonLd type="website" lang={lang} />
</head>
<body>
  <div class="page-curtain" aria-hidden="true"></div>
  <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
  <div class="cursor" aria-hidden="true">
    <span class="cursor__dot"></span>
    <span class="cursor__ring">
      <svg class="cursor__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
  <a href="#main" class="skip-link">{t('a11y.skip')}</a>
  <Header lang={lang} pathname={pathname} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />

  <script>
    /* Global motion layer: smooth scroll (Lenis), page-transition curtain,
       custom cursor (dot + ring with mix-blend-mode), magnetic CTAs.
       Defined in src/scripts/motion.ts. */
    import '../scripts/motion';

    /* Mark JS as ready — CSS now activates the hidden initial state for
       .reveal / .stagger so IntersectionObserver can animate them in.
       Without this, screenshots and JS-disabled viewers see content
       immediately. */
    document.documentElement.classList.add('js-ready');

    /* GSAP IntersectionObserver handles .reveal and .stagger inside motion.ts */

    /* Header scroll state */
    const header = document.querySelector('.site-header');
    const onScroll = () => {
      header?.classList.toggle('scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* Optional Plausible events — runs only when the analytics script exists. */
    const plausible = (window as typeof window & { plausible?: (event: string) => void }).plausible;
    if (plausible) {
      document.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>('[data-track]');
        const name = target?.dataset.track;
        if (name) plausible(name);
      });
      document.querySelectorAll<HTMLFormElement>('form[data-track-submit]').forEach((form) => {
        form.addEventListener('submit', () => plausible(form.dataset.trackSubmit || 'Form submit'));
      });
    }

  </script>
</body>
</html>
