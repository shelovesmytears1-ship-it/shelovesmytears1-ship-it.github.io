---
import { type Lang, withBase } from '../i18n/ui';
import { getNewDirectionCopy, newDirectionLanguages, newDirectionPath } from '../data/newDirectionI18n';

interface Props {
  title: string;
  description?: string;
  current?: 'work' | 'method' | 'about' | 'contact' | 'bots';
  lang?: Lang;
  currentPath?: string;
}

const {
  title,
  description = 'Niezależny frontend developer — projektowanie i wdrażanie stron dla biznesu.',
  current,
  lang = 'pl',
  currentPath = '',
} = Astro.props;

const c = getNewDirectionCopy(lang);
const p = (path = '') => withBase(newDirectionPath(lang, path));

const nav = [
  { key: 'work', label: c.layout.nav.work, href: p('work') },
  { key: 'method', label: c.layout.nav.method, href: p('method') },
  { key: 'about', label: c.layout.nav.about, href: p('about') },
] as const;
---

<!doctype html>
<html lang={lang === 'ua' ? 'uk' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121315" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — overflow</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">{c.layout.skip}</a>

    <header class="new-nav">
      <a class="new-brand" href={p()} aria-label="overflow">overflow<span>.</span></a>
      <nav class="new-nav__links" aria-label={c.layout.mainNavigation}>
        {nav.map((item) => (
          <a class:list={[current === item.key && 'is-active']} href={item.href}>{item.label}</a>
        ))}
      </nav>
      <div class="new-nav__right">
        <div class="new-language-switch" aria-label={c.layout.languageLabel}>
          {newDirectionLanguages.map((locale) => (
            <a
              class:list={[locale === lang && 'is-active']}
              href={withBase(newDirectionPath(locale, currentPath))}
              hreflang={locale === 'ua' ? 'uk' : locale}
              aria-current={locale === lang ? 'page' : undefined}
            >{locale.toUpperCase()}</a>
          ))}
        </div>
        <a class="new-nav__contact" href={p('contact')}>{c.layout.nav.talk} <span aria-hidden="true">↗</span></a>
      </div>
      <button class="new-menu-button" type="button" aria-expanded="false" aria-controls="new-mobile-menu" data-menu-button>{c.layout.nav.menu}</button>
      <nav class="new-mobile-menu" id="new-mobile-menu" aria-label={c.layout.mobileNavigation} data-menu hidden>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={p('contact')}>{c.layout.nav.contact}</a>
        <div class="new-mobile-languages" aria-label={c.layout.languageLabel}>
          {newDirectionLanguages.map((locale) => (
            <a class:list={[locale === lang && 'is-active']} href={withBase(newDirectionPath(locale, currentPath))}>{locale.toUpperCase()}</a>
          ))}
        </div>
      </nav>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="new-footer new-shell">
      <a class="new-brand" href={p()}>overflow<span>.</span></a>
      <p>{c.layout.footer}<br />© 2026</p>
      <a href="https://t.me/zzxvaracaa" target="_blank" rel="noopener">Telegram ↗</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.nd-reveal');

      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        revealItems.forEach((item) => observer.observe(item));
      }

      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-menu]');
      const closeMenu = () => {
        if (!menuButton || !mobileMenu) return;
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('hidden', '');
      };

      menuButton?.addEventListener('click', () => {
        if (!mobileMenu) return;
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        mobileMenu.toggleAttribute('hidden', isOpen);
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --nd-ink: #121315;
    --nd-ink-soft: #1b1d20;
    --nd-ink-raised: #25272a;
    --nd-paper: #f1efe8;
    --nd-muted: #a2a39d;
    --nd-line: rgba(241, 239, 232, 0.18);
    --nd-accent: #c96a2b;
    --nd-shell: min(1320px, calc(100vw - 64px));
    --nd-serif: 'Instrument Serif', Georgia, serif;
    --nd-sans: 'Inter', Arial, sans-serif;
    --nd-mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--nd-ink); }
  body {
    margin: 0;
    background: var(--nd-ink);
    color: var(--nd-paper);
    font-family: var(--nd-sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button, input, select, textarea { font: inherit; }
  .new-shell { width: var(--nd-shell); margin-inline: auto; }
  .new-meta {
    color: var(--nd-muted);
    font-family: var(--nd-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 10px 14px;
    color: var(--nd-ink);
    background: var(--nd-paper);
    transform: translateY(-180%);
  }
  .skip-link:focus { transform: translateY(0); }
  :focus-visible { outline: 2px solid var(--nd-paper); outline-offset: 4px; }

  .new-brand {
    color: var(--nd-paper);
    font-size: 1.24rem;
    font-weight: 600;
    letter-spacing: -0.07em;
  }
  .new-brand span { color: var(--nd-accent); }
  .new-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    height: 76px;
    padding-inline: max(32px, calc((100vw - 1320px) / 2));
    background: linear-gradient(to bottom, rgba(18, 19, 21, 0.94), rgba(18, 19, 21, 0));
  }
  .new-nav__links { display: flex; gap: 2rem; min-width: 0; }
  .new-nav__right { display: flex; justify-self: end; align-items: center; gap: 1.35rem; }
  .new-nav__links a, .new-nav__contact, .new-menu-button {
    color: var(--nd-muted);
    font-size: 0.78rem;
    transition: color 180ms ease;
  }
  .new-nav__links a:hover, .new-nav__links .is-active, .new-nav__contact:hover, .new-menu-button:hover { color: var(--nd-paper); }
  .new-nav__links .is-active { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--nd-accent); }
  .new-language-switch { display: flex; align-items: center; gap: .18rem; padding: .16rem; border: 1px solid var(--nd-line); border-radius: 999px; }
  .new-language-switch a { display: grid; min-width: 26px; min-height: 26px; padding: .2rem; place-items: center; color: var(--nd-muted); font-family: var(--nd-mono); font-size: .62rem; letter-spacing: .03em; }
  .new-language-switch a:hover, .new-language-switch a.is-active { color: var(--nd-ink); background: var(--nd-paper); border-radius: 999px; }
  .new-nav__contact span { color: var(--nd-accent); }
  .new-menu-button, .new-mobile-menu { display: none; }

  .new-page-hero { padding: clamp(10rem, 20vw, 17rem) 0 clamp(5rem, 10vw, 9rem); }
  .new-page-hero__grid { display: grid; grid-template-columns: minmax(170px, 1fr) minmax(0, 2fr); gap: 2rem; }
  .new-page-hero__grid > * { min-width: 0; }
  .new-page-title {
    max-width: 980px;
    margin: 0;
    font-family: var(--nd-serif);
    font-size: clamp(4rem, 9.2vw, 9.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .new-page-title em, .new-section-title em { color: var(--nd-accent); font-weight: inherit; }
  .new-page-lede { max-width: 430px; margin: 2rem 0 0; color: var(--nd-muted); font-size: 1rem; line-height: 1.65; }
  .new-section-title { margin: 0; font-family: var(--nd-serif); font-size: clamp(3.2rem, 6.5vw, 7.1rem); font-weight: 400; letter-spacing: -0.045em; line-height: 0.98; overflow-wrap: anywhere; text-wrap: balance; }
  .new-text-link {
    display: inline-flex;
    gap: 0.8rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--nd-accent);
    color: var(--nd-paper);
    font-family: var(--nd-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }
  .new-text-link:hover { color: var(--nd-accent); }
  .new-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 220px;
    gap: 1.5rem;
    padding: 1rem 1.15rem 1rem 1.3rem;
    border: 1px solid var(--nd-accent);
    color: var(--nd-paper);
    font-size: 0.8rem;
    font-weight: 500;
    transition: transform 220ms ease, background 220ms ease, color 220ms ease;
  }
  .new-button span { color: var(--nd-accent); font-size: 1.1rem; transition: transform 220ms ease; }
  .new-button:hover { background: var(--nd-accent); color: var(--nd-ink); transform: translateY(-3px); }
  .new-button:hover span { color: inherit; transform: translate(3px, -3px); }

  .new-footer { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; padding: 2rem 0; }
  .new-footer p { margin: 0; color: var(--nd-muted); font-family: var(--nd-mono); font-size: 0.61rem; letter-spacing: 0.05em; line-height: 1.6; text-align: center; text-transform: uppercase; }
  .new-footer > a:last-child { justify-self: end; color: var(--nd-muted); font-family: var(--nd-mono); font-size: 0.66rem; text-transform: uppercase; }
  .new-footer > a:last-child:hover { color: var(--nd-paper); }

  .nd-reveal { opacity: 0; transform: translateY(20px); transition: opacity 600ms ease, transform 600ms cubic-bezier(.2,.75,.25,1); }
  .nd-reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 920px) {
    :root { --nd-shell: min(100% - 40px, 1320px); }
    .new-nav { height: 64px; padding-inline: 20px; grid-template-columns: 1fr auto; }
    .new-nav__links, .new-nav__right { display: none; }
    .new-menu-button { display: block; padding: 0; border: 0; background: none; cursor: pointer; }
    .new-mobile-menu { position: absolute; top: 64px; left: 0; display: grid; width: 100%; gap: 1px; padding: 12px 20px 20px; background: var(--nd-ink-soft); border-bottom: 1px solid var(--nd-line); }
    .new-mobile-menu[hidden] { display: none; }
    .new-mobile-menu a { padding: 0.9rem 0; border-bottom: 1px solid var(--nd-line); font-family: var(--nd-serif); font-size: 2rem; }
    .new-mobile-languages { display: flex; gap: .6rem; padding-top: 1.15rem; }
    .new-mobile-languages a { padding: .45rem .6rem; border: 1px solid var(--nd-line); font-family: var(--nd-mono); font-size: .65rem; letter-spacing: .06em; }
    .new-mobile-languages a.is-active { color: var(--nd-ink); background: var(--nd-paper); }
    .new-page-hero { padding-top: 9rem; }
    .new-page-hero__grid { grid-template-columns: 1fr; }
    .new-footer { grid-template-columns: 1fr auto; gap: 2rem; }
    .new-footer p { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
