---
import '../styles/studio.css';
import '../styles/editorial.css';
import '../styles/dark.css';
import '../styles/legibility.css';
import Curtain from '../components/studio/Curtain.astro';
import { getNewDirectionCopy } from '../data/newDirectionI18n';
import type { Lang } from '../i18n/ui';

export type PortfolioVariant = 'studio' | 'editorial' | 'dark';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  current?: 'work' | 'method' | 'about' | 'contact';
  variant?: PortfolioVariant;
}

const { title, description, lang = 'pl', current, variant = 'studio' } = Astro.props;
const c = getNewDirectionCopy(lang);
const htmlLang = lang === 'ua' ? 'uk' : lang;
const segment = variant === 'studio' ? '' : `/${variant}`;

const root = lang === 'pl' ? segment : `/${lang}${segment}`;
const home = `${root || ''}/`;
const p = (slug: string) => `${root}/${slug}/`;

// Every direction is available in PL, RU, EN and UA. Keep the visitor on
// the equivalent page when they switch language, including a case study.
const bare = Astro.url.pathname.replace(/^\/(en|ru|ua)(?=\/|$)/, '') || '/';
const localizedHref = (code: Lang) => {
  if (code === 'pl') return bare;
  return bare === '/' ? `/${code}/` : `/${code}${bare}`;
};
// Legal pages exist per locale (studio only); keep them locale-aware and
// never carry the editorial/dark variant segment into the URL.
const legalRoot = lang === 'pl' ? '' : `/${lang}`;
const legalHref = (slug: string) => `${legalRoot}/${slug}/`;
const locales: { code: Lang; label: string; href: string }[] = [
  { code: 'pl', label: 'PL', href: localizedHref('pl') },
  { code: 'ru', label: 'RU', href: localizedHref('ru') },
  { code: 'en', label: 'EN', href: localizedHref('en') },
  { code: 'ua', label: 'UA', href: localizedHref('ua') },
];

const desc = description ?? c.layout.footer;
const site = 'https://overflow-web.pl';
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL('/og-default.jpg', site).href;
const themeColor = variant === 'dark' ? '#0e0f12' : variant === 'editorial' ? '#f1ece2' : '#f4f2ec';
const ogLocale = lang === 'ru' ? 'ru_RU' : 'pl_PL';
const adaptiveTheme = variant === 'studio';
const themeLabels: Record<Lang, { dark: string; light: string }> = {
  pl: { dark: 'Włącz tryb ciemny', light: 'Włącz tryb jasny' },
  ru: { dark: 'Включить тёмную тему', light: 'Включить светлую тему' },
  en: { dark: 'Switch to dark mode', light: 'Switch to light mode' },
  ua: { dark: 'Увімкнути темну тему', light: 'Увімкнути світлу тему' },
};
const themeLabel = themeLabels[lang];
---

<!doctype html>
<html lang={htmlLang} data-theme={variant} data-theme-adaptive={adaptiveTheme ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={adaptiveTheme ? 'light dark' : variant === 'dark' ? 'dark' : 'light'} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {locales.map((locale) => (
      <link rel="alternate" hreflang={locale.code === 'ua' ? 'uk' : locale.code} href={site + locale.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site + localizedHref('pl')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="overflow — frontend development for business" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: canonical,
      inLanguage: htmlLang,
      mainEntity: {
        '@type': 'Person',
        name: 'Daniil Menshov',
        alternateName: 'overflow',
        jobTitle: lang === 'ru' ? 'Независимый frontend-разработчик' : 'Niezależny frontend developer',
        description: desc,
        url: site,
        image: socialImage,
        address: { '@type': 'PostalAddress', addressLocality: 'Gdańsk', addressCountry: 'PL' },
        email: 'overflow.web1@gmail.com',
        knowsAbout: ['Frontend development', 'Astro', 'TypeScript', 'Web performance', 'UI design'],
        sameAs: ['https://t.me/zzxvaracaa'],
      },
    })} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/BricolageGrotesque-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Outfit-Regular.ttf" as="font" type="font/ttf" crossorigin />
    {variant === 'editorial' && (
      <>
        <link rel="preload" href="/fonts/Gloock-Regular.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/Newsreader-Variable.ttf" as="font" type="font/ttf" crossorigin />
      </>
    )}
    <!-- arm the curtain before first paint so navigations never flash -->
    <script is:inline define:vars={{ adaptiveTheme }}>
      document.documentElement.classList.add('curtain-on');
      if (adaptiveTheme) {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem('overflow-theme');
        } catch {}
        const resolvedTheme =
          savedTheme === 'studio-dark' || savedTheme === 'dark'
            ? 'studio-dark'
            : savedTheme === 'studio'
              ? 'studio'
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'studio-dark'
                : 'studio';
        document.documentElement.dataset.theme = resolvedTheme;
        document.documentElement.style.colorScheme = resolvedTheme === 'studio-dark' ? 'dark' : 'light';
      }
    </script>
  </head>
  <body data-theme={variant}>
    {adaptiveTheme && (
      <script is:inline>
        document.body.dataset.theme = document.documentElement.dataset.theme || 'studio';
      </script>
    )}
    <a class="skip" href="#main">{c.layout.skip}</a>
    <Curtain lang={lang} />
    <div class="cur" aria-hidden="true"><div class="cur-ring"><span class="cur-label"></span></div></div>

    <header class="hdr">
      <div class="wrap nav">
        <a class="brand" href={home} aria-label="overflow" data-tname="overflow">
          <img src="/logo.png" alt="overflow" class="logo-img" width="142" height="30" decoding="async" />
        </a>
        <nav class="nav-links" aria-label={c.layout.mainNavigation}>
          <a href={p('work')} aria-current={current === 'work' ? 'page' : undefined} data-cursor data-tname={c.layout.nav.work}>{c.layout.nav.work}</a>
          <a href={p('method')} aria-current={current === 'method' ? 'page' : undefined} data-cursor data-tname={c.layout.nav.method}>{c.layout.nav.method}</a>
          <a href={p('about')} aria-current={current === 'about' ? 'page' : undefined} data-cursor data-tname={c.layout.nav.about}>{c.layout.nav.about}</a>
        </nav>
        <div class="nav-right">
          <div class="lang" aria-label={c.layout.languageLabel}>
            {locales.map((l) => (
              <a href={l.href} aria-current={l.code === lang ? 'page' : undefined} data-cursor>{l.label}</a>
            ))}
          </div>
          {adaptiveTheme && (
            <button
              class="theme-toggle theme-toggle--desktop"
              type="button"
              data-theme-toggle
              data-cursor
              data-label-dark={themeLabel.dark}
              data-label-light={themeLabel.light}
              aria-label={themeLabel.dark}
              aria-pressed="false"
              title={themeLabel.dark}
            >
              <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.2 15.4A8.4 8.4 0 0 1 8.6 3.8 8.4 8.4 0 1 0 20.2 15.4Z"></path>
              </svg>
              <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
              </svg>
            </button>
          )}
          <a class="nav-cta" href={p('contact')} aria-current={current === 'contact' ? 'page' : undefined} data-cursor data-tname={c.layout.nav.talk}><span class="btn-text">{c.layout.nav.talk} ↗&#xFE0E;</span></a>
          <button class="burger" id="burger" type="button" aria-label={c.layout.nav.menu} aria-expanded="false" aria-controls="mnav">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- full-screen menu; the CTA above stays reachable so the money action is
         never the thing hidden behind a toggle -->
    <nav class="mnav" id="mnav" aria-label={c.layout.mobileNavigation} inert>
      <div class="wrap mnav-inner">
        <a href={p('work')} data-tname={c.layout.nav.work}><span>01</span>{c.layout.nav.work}</a>
        <a href={p('method')} data-tname={c.layout.nav.method}><span>02</span>{c.layout.nav.method}</a>
        <a href={p('about')} data-tname={c.layout.nav.about}><span>03</span>{c.layout.nav.about}</a>
        <a href={p('contact')} data-tname={c.layout.nav.talk}><span>04</span>{c.layout.nav.talk}</a>
        {adaptiveTheme && (
          <div class="mnav-theme-row">
            <button
              class="theme-toggle theme-toggle--mobile"
              type="button"
              data-theme-toggle
              data-cursor
              data-label-dark={themeLabel.dark}
              data-label-light={themeLabel.light}
              aria-label={themeLabel.dark}
              aria-pressed="false"
            >
              <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.2 15.4A8.4 8.4 0 0 1 8.6 3.8 8.4 8.4 0 1 0 20.2 15.4Z"></path>
              </svg>
              <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
              </svg>
              <span data-theme-label>{themeLabel.dark}</span>
            </button>
          </div>
        )}
        <div class="mnav-foot">
          <span data-clock data-label="">—</span>
          <span class="mnav-lang">
            {locales.map((l) => (
              <a href={l.href} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a>
            ))}
          </span>
          <span>Gdańsk · PL</span>
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="ftr wrap" data-speed="-1.2">
      <span>© 2026 overflow — Gdańsk</span>
      <span id="clock" data-clock data-label="Local time">Local time —</span>
      <span>{c.layout.footer}</span>
      <span class="ftr-legal">
        <a href={legalHref('privacy')}>{c.legal.privacyNav}</a>
        <a href={legalHref('impressum')}>{c.legal.impressumNav}</a>
      </span>
    </footer>

    <script>
      import '../scripts/curtain.ts';
      import '../scripts/studio.ts';
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
