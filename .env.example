TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rozkwit flower shop — Stripe (TEST mode). Get keys at dashboard.stripe.com (Test mode ON).
# PREFER a restricted API key (rk_test_...) scoped to "Checkout Sessions: write".
# A full secret key (sk_test_...) also works. Store the real value in Netlify env, not here.
STRIPE_SECRET_KEY=rk_test_...
# For the webhook (fulfillment): Netlify → whsec_... from the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: absolute site URL for Stripe return links (else derived from request Host)
SITE_URL=
